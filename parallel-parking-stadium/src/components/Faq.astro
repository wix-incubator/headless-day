---
interface Props {
  faqs: { q: string; a: string }[];
}
const { faqs } = Astro.props;
---

<div style="border-top:2px solid var(--grid)">
  {
    faqs.map((f, i) => (
      <details class="faq" open={i === 0}>
        <summary>
          <span class="dk faq-q">{f.q}</span>
          <span class="arcade faq-sign" aria-hidden="true" />
        </summary>
        <p class="faq-a">{f.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    border-bottom: 2px solid var(--grid);
  }
  .faq summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 18px 0;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq-q {
    font-size: clamp(18px, 2.4vw, 23px);
    color: var(--ink);
  }
  .faq-sign {
    font-size: 14px;
    color: var(--cyan);
    flex: none;
  }
  .faq-sign::before {
    content: '+';
  }
  .faq[open] .faq-sign::before {
    content: '–';
  }
  .faq-a {
    margin: 0;
    padding: 0 0 22px;
    font-size: 19px;
    line-height: 1.45;
    color: var(--ink-dim);
    max-width: 700px;
  }
</style>
