# Copy this file to `.env.local` and fill in your values.
# Never commit a real `.env.local`.

# OAuth client ID — Dashboard → Settings → Headless Settings → OAuth apps.
# Used for CMS reads and ticket holds (`PUBLIC_WIX_CLIENT_ID`).
PUBLIC_WIX_CLIENT_ID=YOUR_CLIENT_ID_HERE

# Used only by `npm run seed` (CMS bootstrap). Not required for `wix dev`.
# Dashboard → Settings → API Keys (grant Wix Data).
WIX_API_KEY=YOUR_API_KEY_HERE

# Used by `npm run seed`.
# Dashboard → Settings → Headless Settings (site / metasite id).
WIX_SITE_ID=YOUR_SITE_ID_HERE
