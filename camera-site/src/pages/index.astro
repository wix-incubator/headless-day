import { getWixClient } from "../lib/wix-client";

// Tag → zone mapping: product name (lowercase) determines the body zone
function zoneForName(name = "") {
  const n = name.toLowerCase();
  if (n.includes("ear")) return "ears";
  if (n.includes("neck")) return "neck";
  if (n.includes("hat") || n.includes("head")) return "head";
  if (n.includes("wrist") || n.includes("bracelet")) return "wrist";
  return null;
}

function imageUrlFromMedia(media) {
  const id = media?.main?._id;
  return id ? `https://static.wixstatic.com/media/${id}` : null;
}

let products = [];
try {
  const wixClient = getWixClient(Astro.locals);
  const { items } = await wixClient.productsV3.queryProducts().find();
  products = items
    .map((item) => {
      const zone = zoneForName(item.name);
      const imageUrl = imageUrlFromMedia(item.media);
      if (!zone || !imageUrl) return null;
      return {
        id: item._id,
        name: item.name,
        zone,
        price: item.actualPriceRange?.minValue?.amount ?? "0",
        imageUrl,
        slug: item.slug,
      };
    })
    .filter(Boolean);
} catch (err) {
  console.error("Failed to load products from Wix Stores:", err);
}

const earsProducts = products.filter((p) => p.zone === "ears");
const neckProducts = products.filter((p) => p.zone === "neck");
const headProducts = products.filter((p) => p.zone === "head");
