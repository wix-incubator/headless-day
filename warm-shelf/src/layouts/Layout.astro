---
const nav = [
	{ href: '/books', label: 'Books' },
	{ href: '/book-crossing', label: 'Book Crossing' },
	{ href: '/events', label: 'Events' },
	{ href: '/services', label: 'Services' },
];
const path = Astro.url.pathname;
const isHome = path === '/';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<slot name="seo-tags" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header class:list={['site-header', { 'over-hero': isHome }]} id="site-header">
			<a class="wordmark" href="/">Warm&nbsp;Shelf</a>
			<nav class="site-nav">
				{nav.map((item) => (
					<a href={item.href} class:list={{ active: path.startsWith(item.href) }}>{item.label}</a>
				))}
			</nav>
			<a class="cart-link" href="/cart">Cart</a>
		</header>

		<slot />

		<footer class="site-footer">
			<div class="footer-inner">
				<div>
					<p class="wordmark footer-mark">Warm Shelf</p>
					<p class="footer-tagline">A bookstore, a café, and a shelf that gives back.</p>
				</div>
				<div class="footer-col">
					<p class="footer-heading">Visit</p>
					<p>Open daily 9:00 – 21:00</p>
					<p>Summer terrace open till late</p>
				</div>
				<div class="footer-col">
					<p class="footer-heading">Explore</p>
					{nav.map((item) => (
						<a href={item.href}>{item.label}</a>
					))}
				</div>
			</div>
			<p class="footer-note">© {new Date().getFullYear()} Warm Shelf. Brewed with care.</p>
		</footer>

		<script is:inline>
			// Scroll-reveal for elements marked .reveal
			(function () {
				const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				const els = document.querySelectorAll('.reveal');
				if (reduce || !('IntersectionObserver' in window)) {
					els.forEach((el) => el.classList.add('in'));
				} else {
					const io = new IntersectionObserver(
						(entries) => {
							entries.forEach((e) => {
								if (e.isIntersecting) {
									e.target.classList.add('in');
									io.unobserve(e.target);
								}
							});
						},
						{ threshold: 0.15 }
					);
					els.forEach((el) => io.observe(el));
				}

				// Header turns solid after scrolling past the hero
				const header = document.getElementById('site-header');
				if (header && header.classList.contains('over-hero')) {
					const onScroll = () => {
						if (window.scrollY > window.innerHeight * 0.7) header.classList.add('solid');
						else header.classList.remove('solid');
					};
					onScroll();
					window.addEventListener('scroll', onScroll, { passive: true });
				}
			})();
		</script>
	</body>
</html>

<style is:global>
	:root {
		--cream: #faf6ee;
		--paper: #f3ecdd;
		--sand: #e9dfca;
		--line: #e0d5bd;
		--ink: #3b3226;
		--ink-soft: #75684f;
		--olive: #6e7a4e;
		--olive-deep: #535e3a;
		--sage: #cdd5bc;
		--sage-soft: #e4e8d7;
		--terracotta: #c4663b;
		--terracotta-soft: #f4e0d4;
		--amber: #d99a2b;
		--amber-soft: #f6e9cd;
		--radius: 18px;
		--radius-sm: 10px;
		--header-h: 68px;
		--measure: 62ch;
		--font-display: 'Fraunces', Georgia, serif;
		--font-body: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
	}

	* { box-sizing: border-box; }

	html {
		background: var(--cream);
		scroll-behavior: smooth;
		scroll-padding-top: var(--header-h);
	}

	body {
		margin: 0;
		font-family: var(--font-body);
		color: var(--ink);
		line-height: 1.6;
		font-size: 16px;
		overflow-x: hidden;
	}

	h1, h2, h3, h4 {
		font-family: var(--font-display);
		font-weight: 500;
		line-height: 1.12;
		margin: 0 0 0.5em;
		letter-spacing: -0.01em;
	}

	h1 { font-size: clamp(2.4rem, 6vw, 4.4rem); }
	h2 { font-size: clamp(1.8rem, 3.6vw, 2.8rem); }
	h3 { font-size: 1.3rem; }

	p { margin: 0 0 1em; }
	a { color: inherit; }
	img { max-width: 100%; display: block; }

	/* ---- header ---- */
	.site-header {
		display: flex;
		align-items: center;
		gap: 2rem;
		height: var(--header-h);
		padding: 0 clamp(1rem, 4vw, 3.5rem);
		border-bottom: 1px solid var(--line);
		background: var(--cream);
		position: sticky;
		top: 0;
		z-index: 50;
		transition: background 0.3s ease, border-color 0.3s ease, color 0.3s ease;
	}

	.site-header.over-hero {
		position: fixed;
		left: 0;
		right: 0;
		background: transparent;
		border-color: transparent;
		color: var(--cream);
	}
	.site-header.over-hero .cart-link { border-color: rgba(250, 246, 238, 0.7); color: var(--cream); }
	.site-header.over-hero .site-nav a { color: rgba(250, 246, 238, 0.85); }
	.site-header.over-hero.solid {
		position: fixed;
		background: var(--cream);
		border-color: var(--line);
		color: var(--ink);
	}
	.site-header.over-hero.solid .cart-link { border-color: var(--ink); color: var(--ink); }
	.site-header.over-hero.solid .site-nav a { color: var(--ink-soft); }

	.wordmark {
		font-family: var(--font-display);
		font-size: 1.5rem;
		font-weight: 600;
		text-decoration: none;
	}

	.site-nav { display: flex; gap: 1.5rem; flex: 1; flex-wrap: wrap; }
	.site-nav a {
		text-decoration: none;
		font-size: 0.95rem;
		color: var(--ink-soft);
		padding-bottom: 2px;
		border-bottom: 2px solid transparent;
		transition: color 0.2s ease;
	}
	.site-nav a:hover { color: currentColor; }
	.site-nav a.active { border-bottom-color: var(--olive); }

	.cart-link {
		text-decoration: none;
		font-size: 0.95rem;
		font-weight: 500;
		padding: 0.45rem 1.2rem;
		border: 1px solid currentColor;
		border-radius: 999px;
		transition: background 0.2s ease, color 0.2s ease;
	}
	.cart-link:hover { background: var(--terracotta); border-color: var(--terracotta); color: var(--cream); }

	main { min-height: 60vh; }

	/* ---- layout ---- */
	.container {
		width: 100%;
		margin: 0 auto;
		padding: 0 clamp(1.25rem, 4vw, 4rem);
	}

	.measure { max-width: var(--measure); }

	.section { padding: clamp(3rem, 7vw, 6rem) 0; }
	.section-tight { padding: clamp(2rem, 4vw, 3.5rem) 0; }

	.section-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 2.2rem;
		flex-wrap: wrap;
	}
	.section-head p { color: var(--ink-soft); margin: 0.4rem 0 0; }

	.see-all {
		font-size: 0.92rem;
		font-weight: 500;
		color: var(--olive-deep);
		text-decoration: none;
		border-bottom: 1px solid var(--sage);
		white-space: nowrap;
		padding-bottom: 2px;
	}
	.see-all:hover { border-color: var(--olive-deep); }

	.eyebrow {
		display: inline-block;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--olive-deep);
		margin-bottom: 0.9rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-body);
		font-size: 0.98rem;
		font-weight: 500;
		padding: 0.8rem 1.7rem;
		border-radius: 999px;
		border: 1px solid transparent;
		text-decoration: none;
		cursor: pointer;
		transition: background 0.18s ease, color 0.18s ease, transform 0.18s ease, border-color 0.18s ease;
	}
	.btn:hover { transform: translateY(-2px); }
	.btn-primary { background: var(--olive-deep); color: var(--cream); }
	.btn-primary:hover { background: var(--olive); }
	.btn-accent { background: var(--terracotta); color: var(--cream); }
	.btn-accent:hover { background: #a95530; }
	.btn-outline { border-color: currentColor; color: var(--ink); background: transparent; }
	.btn-outline:hover { background: var(--ink); color: var(--cream); border-color: var(--ink); }
	.btn-light { background: var(--cream); color: var(--ink); }
	.btn-light:hover { background: #fff; }
	.btn[disabled] { opacity: 0.5; cursor: not-allowed; transform: none; }

	.card {
		background: #fffdf8;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		overflow: hidden;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
	a.card:hover { transform: translateY(-4px); box-shadow: 0 18px 40px -24px rgba(59, 50, 38, 0.4); }

	/* book cover floats & tilts in 3-D on hover — no card chrome; tight crop drops the artwork backdrop */
	.book-card { background: transparent; border: none; overflow: visible; box-shadow: none; perspective: 1000px; }
	.book-card .cover {
		aspect-ratio: 3 / 4; overflow: hidden; border-radius: var(--radius-sm);
		box-shadow: 0 12px 28px -16px rgba(59, 50, 38, 0.5);
		transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.5s ease;
		transform-origin: center center; backface-visibility: hidden;
	}
	.book-card .cover img { width: 100%; height: 100%; object-fit: cover; display: block; transform: scale(1.34); }
	.book-card .card-body { background: transparent; padding-left: 0.15rem; padding-right: 0.15rem; }
	a.book-card:hover { transform: none; box-shadow: none; }
	a.book-card:hover .cover {
		transform: rotateY(-19deg) rotateX(5deg) translateY(-10px) scale(1.04);
		box-shadow: -28px 34px 52px -22px rgba(59, 50, 38, 0.55);
	}
	@media (prefers-reduced-motion: reduce) {
		.book-card .cover { transition: none; }
		a.book-card:hover .cover { transform: translateY(-6px); }
	}

	.chip {
		display: inline-block;
		font-size: 0.75rem;
		font-weight: 500;
		padding: 0.22rem 0.75rem;
		border-radius: 999px;
		background: var(--paper);
		color: var(--ink-soft);
	}
	.chip-olive { background: var(--sage-soft); color: var(--olive-deep); }
	.chip-amber { background: var(--amber-soft); color: #8a5f12; }
	.chip-terracotta { background: var(--terracotta-soft); color: var(--terracotta); }

	.themed-block {
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding: 1rem;
		background: linear-gradient(145deg, var(--sage-soft), var(--sand));
		color: var(--olive-deep);
		font-family: var(--font-display);
	}

	.grid { display: grid; gap: 1.6rem; }
	.grid-2 { grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); }
	.grid-3 { grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
	.grid-4 { grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); }

	/* ---- photo tiles: image + gradient + text overlay ---- */
	.photo-tile {
		position: relative;
		overflow: hidden;
		border-radius: var(--radius);
		isolation: isolate;
	}
	.photo-tile img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s ease;
	}
	.photo-tile:hover img { transform: scale(1.05); }
	.photo-tile::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(43, 35, 22, 0.82) 0%, rgba(43, 35, 22, 0.25) 45%, rgba(43, 35, 22, 0) 75%);
		z-index: 1;
	}
	.photo-tile .tile-text {
		position: absolute;
		inset: auto 0 0 0;
		z-index: 2;
		padding: clamp(1.2rem, 2.5vw, 2rem);
		color: var(--cream);
	}
	.photo-tile .tile-text h3 { color: var(--cream); margin-bottom: 0.25rem; }
	.photo-tile .tile-text p { color: rgba(250, 246, 238, 0.85); margin: 0; font-size: 0.92rem; }

	/* ---- parallax band ---- */
	.parallax {
		position: relative;
		background-size: cover;
		background-position: center;
		background-attachment: fixed;
	}
	.parallax::before {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(120deg, rgba(43, 35, 22, 0.72), rgba(83, 94, 58, 0.55));
	}
	.parallax > * { position: relative; z-index: 1; }
	@media (hover: none) {
		.parallax { background-attachment: scroll; }
	}

	/* ---- forms ---- */
	.field { display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 1rem; }
	.field label { font-size: 0.88rem; font-weight: 500; }
	.field input, .field select, .field textarea {
		font-family: var(--font-body);
		font-size: 0.95rem;
		padding: 0.65rem 0.9rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		background: #fffdf8;
		color: var(--ink);
	}
	.field input:focus, .field select:focus, .field textarea:focus {
		outline: 2px solid var(--sage);
		border-color: var(--olive);
	}

	.notice { padding: 0.9rem 1.1rem; border-radius: var(--radius-sm); font-size: 0.92rem; }
	.notice-ok { background: var(--sage-soft); color: var(--olive-deep); }
	.notice-err { background: var(--terracotta-soft); color: #8f3f1c; }

	/* ---- scroll reveal ---- */
	.reveal { opacity: 0; transform: translateY(28px); transition: opacity 0.7s ease, transform 0.7s ease; }
	.reveal.in { opacity: 1; transform: none; }
	.reveal.d1 { transition-delay: 0.08s; }
	.reveal.d2 { transition-delay: 0.16s; }
	.reveal.d3 { transition-delay: 0.24s; }
	@media (prefers-reduced-motion: reduce) {
		.reveal { opacity: 1; transform: none; transition: none; }
		html { scroll-behavior: auto; }
	}

	/* ---- footer ---- */
	.site-footer {
		border-top: 1px solid var(--line);
		background: var(--paper);
		padding: 3.5rem clamp(1.25rem, 4vw, 4rem) 1.5rem;
		margin-top: 4rem;
	}
	.footer-inner {
		width: 100%;
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		gap: 2rem;
	}
	.footer-mark { font-size: 1.4rem; margin-bottom: 0.3rem; }
	.footer-tagline { color: var(--ink-soft); max-width: 30ch; }
	.footer-heading { font-weight: 600; font-size: 0.85rem; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 0.6rem; }
	.footer-col p { margin: 0 0 0.4rem; color: var(--ink-soft); font-size: 0.92rem; }
	.footer-col a { display: block; color: var(--ink-soft); font-size: 0.92rem; text-decoration: none; margin-bottom: 0.4rem; }
	.footer-col a:hover { color: var(--ink); }
	.footer-note { margin: 2.5rem 0 0; color: var(--ink-soft); font-size: 0.8rem; }

	@media (max-width: 720px) {
		.site-header { flex-wrap: wrap; height: auto; padding-top: 0.7rem; padding-bottom: 0.7rem; gap: 0.7rem 1.2rem; }
		.site-header.over-hero { position: absolute; }
		.site-nav { order: 3; width: 100%; gap: 1rem; }
		.footer-inner { grid-template-columns: 1fr; }
	}
</style>
