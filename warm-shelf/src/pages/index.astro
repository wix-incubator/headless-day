---
import Layout from '../layouts/Layout.astro';
import HeroSlider from '../components/HeroSlider';
import ExLibrisStudio from '../components/ExLibrisStudio';
import BookCrossingFlow from '../components/BookCrossingFlow.astro';
import { productsV3 } from '@wix/stores';
import { wixEventsV2 } from '@wix/events';
import { services } from '@wix/bookings';
import { items } from '@wix/data';
import { imgSrc, formatPrice } from '../lib/media';
import { SLIDER, INTERIOR, TERRACE, HERO, EVENT_GALLERY, galleryFor } from '../lib/images';

const BOOKING_APP_ID = '13d21c63-b5ec-5912-8397-c3a5ddb27a97';

let books: any[] = [];
try {
	books = (await productsV3.queryProducts().limit(8).find()).items ?? [];
} catch {}

let events: any[] = [];
try {
	const res = await wixEventsV2.queryEvents({
		filter: { status: { $in: ['UPCOMING', 'STARTED'] } },
		sort: [{ fieldName: 'dateAndTimeSettings.startDate', order: 'ASC' }],
		paging: { limit: 3 },
	});
	events = res.events ?? [];
} catch {}

let serviceList: any[] = [];
let exLibrisHref = '/services';
try {
	const res = await services
		.queryServices({ conditionalFields: ['STAFF_MEMBER_DETAILS'] })
		.eq('appId', BOOKING_APP_ID)
		.limit(4)
		.find();
	serviceList = (res.items ?? []).filter((s: any) => !s.hidden).slice(0, 2);
	const exSvc = serviceList.find((s: any) => /ex\s*libris/i.test(s.name ?? ''));
	if (exSvc?.mainSlug?.name) exLibrisHref = `/services/${exSvc.mainSlug.name}`;
} catch {}

let shelfCount = 0;
try {
	shelfCount = (await items.query('BookCrossingShelf').limit(50).find()).items?.length ?? 0;
} catch {}

function eventDateParts(e: any) {
	const d = e?.dateAndTimeSettings?.startDate;
	if (!d) return null;
	const dt = new Date(d);
	return {
		day: new Intl.DateTimeFormat('en', { day: 'numeric', timeZone: 'Europe/Kyiv' }).format(dt),
		month: new Intl.DateTimeFormat('en', { month: 'short', timeZone: 'Europe/Kyiv' }).format(dt),
		full: new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Europe/Kyiv' }).format(dt),
	};
}
---

<Layout>
	<main>
		<!-- ─── HERO ─── -->
		<div class="hero-holder" id="top">
			<div class="hero-boot">
				<img src={SLIDER[0].url} alt="Inside Warm Shelf" />
				<div class="hero-boot-scrim"></div>
				<div class="hero-boot-copy">
					<span class="eyebrow" style="color: var(--amber-soft);">Bookstore · Café · Community shelf</span>
					<h1>Books, coffee, and a shelf that gives back</h1>
					<p>A slow corner of the city — new books, a free book-crossing library, author evenings and armchairs you won't want to leave.</p>
					<div class="hero-boot-actions">
						<a class="btn btn-accent" href="/books">Browse books</a>
						<a class="btn btn-light" href="/events">What's on</a>
					</div>
				</div>
			</div>
			<div class="hero-live">
				<HeroSlider
					client:only="react"
					slides={SLIDER}
					eyebrow="Bookstore · Café · Community shelf"
					title="Books, coffee, and a shelf that gives back"
					subtitle="A slow corner of the city — new books, a free book-crossing library, author evenings and armchairs you won't want to leave."
				/>
			</div>
		</div>

		<!-- ─── EX LIBRIS CONSTRUCTOR ─── -->
		<section class="section els-home-section" id="ex-libris">
			<div class="container">
				<div class="section-head reveal">
					<div>
						<span class="eyebrow">Craft your mark</span>
						<h2>Design your own Ex Libris</h2>
						<p>
							Pick a stamp shape, choose a handle, upload your art — then book a session
							to have it carved into a real stamp at our craft table. Download the
							print-ready plate to bring in.
						</p>
					</div>
					<a class="see-all" href={exLibrisHref}>Book a session →</a>
				</div>
				<div class="reveal">
					<ExLibrisStudio client:only="react" bookingHref={exLibrisHref} />
				</div>
			</div>
		</section>

		<!-- ─── BOOK-CROSSING FLOW ─── -->
		<section class="section bcf-home-section">
			<div class="container">
				<div class="section-head reveal">
					<div>
						<span class="eyebrow">How it works</span>
						<h2>The book-crossing journey</h2>
						<p>Every book on our free shelf has a story — pick it up, read it, bring it back or pass it on.</p>
					</div>
					<a class="see-all" href="/book-crossing">Browse the shelf →</a>
				</div>
				<BookCrossingFlow />
			</div>
		</section>

		<!-- ─── NEW BOOKS ─── -->
		<section class="section">
			<div class="container">
				<div class="section-head reveal">
					<div>
						<span class="eyebrow">The bookstore</span>
						<h2>New on our shelves</h2>
						<p>Hand-picked titles you can take home today.</p>
					</div>
					<a class="see-all" href="/books">All books →</a>
				</div>
				<div class="grid grid-4">
					{books.map((p: any, i: number) => {
						const src = imgSrc(p.media?.main, 500, 680);
						return (
							<a class={`card book-card reveal d${i % 4}`} href={`/books/${p.slug}`}>
								{src ? (
									<div class="cover"><img src={src} alt={p.name} loading="lazy" /></div>
								) : (
									<div class="themed-block" style="aspect-ratio: 3/4;">{p.name}</div>
								)}
								<div class="card-body">
									<h3>{p.name}</h3>
									<p class="price">{formatPrice(p.actualPriceRange?.minValue?.amount, (p as any).currency)}</p>
								</div>
							</a>
						);
					})}
				</div>
			</div>
		</section>

		<!-- ─── SPACE BAND ─── -->
		<section class="parallax space-band" style={`background-image: url(${TERRACE})`}>
			<div class="container band-inner reveal">
				<span class="eyebrow" style="color: var(--amber-soft);">Our space</span>
				<h2>Made for staying a while</h2>
				<p>
					Deep armchairs and poufs, knitted blankets, warm lamplight, and green plants trailing
					between the shelves. In summer the terrace opens — string lights and poetry under the sky.
				</p>
				<a class="btn btn-light" href="#ex-libris">Design your ex libris</a>
			</div>
		</section>

		<!-- ─── SPACE TILES ─── -->
		<section class="section">
			<div class="container">
				<div class="grid space-tiles">
					<a class="photo-tile reveal" href="/book-crossing" style="aspect-ratio: 4/5;">
						<img src={HERO} alt="Shelves and plants" loading="lazy" />
						<div class="tile-text">
							<span class="chip chip-olive">Free library</span>
							<h3>The book-crossing shelf</h3>
							<p>{shelfCount > 0 ? `${shelfCount} books waiting to be borrowed` : 'Borrow, read, pass it on'}</p>
						</div>
					</a>
					<a class="photo-tile reveal d1" href="#ex-libris" style="aspect-ratio: 4/5;">
						<img src={INTERIOR} alt="Reading corner" loading="lazy" />
						<div class="tile-text">
							<span class="chip chip-terracotta">Craft</span>
							<h3>Make a book yours</h3>
							<p>Design your ex libris right here</p>
						</div>
					</a>
					<a class="photo-tile reveal d2" href="/events" style="aspect-ratio: 4/5;">
						<img src={TERRACE} alt="Summer terrace" loading="lazy" />
						<div class="tile-text">
							<span class="chip chip-amber">What's on</span>
							<h3>Evenings on the terrace</h3>
							<p>Readings, poetry & book club</p>
						</div>
					</a>
				</div>
			</div>
		</section>

		<!-- ─── EVENTS TEASER ─── -->
		<section class="section events-teaser">
			<div class="container">
				<div class="section-head reveal">
					<div>
						<span class="eyebrow">What's on</span>
						<h2>Upcoming events</h2>
						<p>All free — just RSVP.</p>
					</div>
					<a class="see-all" href="/events">Full schedule →</a>
				</div>
				<div class="grid grid-3">
					{events.map((e: any, i: number) => {
						const parts = eventDateParts(e);
						const src = imgSrc(e.mainImage, 700, 460) || galleryFor(e.slug ?? e._id, EVENT_GALLERY, 1)[0];
						return (
							<a class={`photo-tile event-tile reveal d${i}`} href={`/events/${e.slug}`} style="aspect-ratio: 3/2;">
								<img src={src} alt={e.title} loading="lazy" />
								<div class="tile-text">
									<span class="event-badge"><b>{parts?.day}</b> {parts?.month}</span>
									<h3>{e.title}</h3>
									<p>{parts?.full} · {e.location?.name}</p>
								</div>
							</a>
						);
					})}
				</div>
			</div>
		</section>

		<!-- ─── SERVICES TEASER ─── -->
		<section class="section services-teaser">
			<div class="container">
				<div class="section-head reveal">
					<div>
						<span class="eyebrow">Book personalization</span>
						<h2>Make a book truly yours</h2>
						<p>Small rituals for people who love their libraries.</p>
					</div>
					<a class="see-all" href="/services">All services →</a>
				</div>
				<div class="grid grid-2">
					{serviceList.map((s: any, i: number) => {
						const src = imgSrc(s.media?.mainMedia?.image, 820, 520);
						const duration = s.schedule?.availabilityConstraints?.sessionDurations?.[0];
						const price = s.payment?.fixed?.price;
						return (
							<a class={`photo-tile service-tile reveal d${i}`} href={`/services/${s.mainSlug?.name}`} style="aspect-ratio: 16/10;">
								{src ? <img src={src} alt={s.name} loading="lazy" /> : <div class="tile-fallback"></div>}
								<div class="tile-text">
									<h3>{s.name}</h3>
									<p>{duration ? `${duration} min` : ''}{duration && price?.value ? ' · ' : ''}{formatPrice(price?.value, price?.currency)}</p>
								</div>
							</a>
						);
					})}
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	.hero-holder { position: relative; height: 100svh; min-height: 560px; }
	.hero-boot { position: absolute; inset: 0; z-index: 1; overflow: hidden; }
	.hero-boot img { width: 100%; height: 100%; object-fit: cover; }
	.hero-boot-scrim {
		position: absolute; inset: 0;
		background: linear-gradient(to top, rgba(43,35,22,0.85), rgba(43,35,22,0.2) 45%, rgba(43,35,22,0.35));
	}
	.hero-boot-copy {
		position: absolute; z-index: 2; top: 50%; transform: translateY(-50%);
		max-width: 1500px; width: 100%; padding: 0 clamp(1.5rem, 5vw, 5rem); color: var(--cream);
	}
	.hero-boot-copy h1 { color: var(--cream); max-width: 16ch; }
	.hero-boot-copy p { max-width: 46ch; color: rgba(250,246,238,0.9); font-size: clamp(1rem, 1.5vw, 1.2rem); }
	.hero-boot-actions { display: flex; gap: 0.9rem; flex-wrap: wrap; margin-top: 1.8rem; }
	.hero-live { position: absolute; inset: 0; z-index: 2; }

	.els-home-section {
		background: linear-gradient(to bottom,
			rgba(250,246,238,0) 0%, var(--paper) 110px,
			var(--paper) calc(100% - 110px), rgba(250,246,238,0) 100%);
	}
	.bcf-home-section {
		background: linear-gradient(to bottom,
			rgba(250,246,238,0) 0%, var(--sage-soft) 110px,
			var(--sage-soft) calc(100% - 110px), rgba(250,246,238,0) 100%);
	}

	.card { text-decoration: none; display: flex; flex-direction: column; }
	.card-body { padding: 1.1rem 1.2rem 1.3rem; }
	.card-body h3 { margin-bottom: 0.35rem; }
	.price { font-weight: 600; color: var(--terracotta); margin: 0; }

	.space-band { padding: clamp(4rem, 10vw, 8rem) 0; color: var(--cream); }
	.band-inner { color: var(--cream); }
	.band-inner h2 { color: var(--cream); max-width: 18ch; }
	.band-inner p { color: rgba(250,246,238,0.9); max-width: 52ch; }

	.space-tiles { grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
	.tile-fallback { position: absolute; inset: 0; background: linear-gradient(145deg, var(--amber-soft), var(--terracotta-soft)); }

	.event-tile .event-badge {
		display: inline-flex; align-items: baseline; gap: 0.3rem;
		background: var(--amber); color: #3b2a06;
		padding: 0.15rem 0.6rem; border-radius: 999px; font-size: 0.8rem; font-weight: 600; margin-bottom: 0.4rem;
	}
	.event-tile .event-badge b { font-size: 1rem; }

	@media (max-width: 720px) {
		.hero-boot-copy { top: auto; bottom: 2rem; transform: none; }
	}
</style>
