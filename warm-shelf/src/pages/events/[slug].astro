---
import Layout from '../../layouts/Layout.astro';
import { WIX_APPS } from '@wix/essentials';
import { SEO } from '@wix/seo/components';
import { loadSEOTagsServiceConfig } from '@wix/seo/services';
import { seoTags } from '@wix/seo';
import { wixEventsV2 } from '@wix/events';
import { imgSrc } from '../../lib/media';
import { EVENT_GALLERY, galleryFor } from '../../lib/images';
import RsvpForm from '../../components/RsvpForm';

export const wixMetadata = {
	appDefId: WIX_APPS.events.id,
	pageIdentifier: WIX_APPS.events.eventPageMetadata.pageIdentifier,
	identifiers: {
		slug: WIX_APPS.events.eventPageMetadata.identifiers.slug,
	},
};

const slug = Astro.params.slug!;

let event: any = null;
let seoTagsServiceConfig: any = null;
try {
	const [eventRes, seoRes] = await Promise.all([
		wixEventsV2.getEventBySlug(slug, { fields: ['DETAILS', 'TEXTS', 'REGISTRATION', 'URLS'] } as any),
		loadSEOTagsServiceConfig({
			pageUrl: Astro.url.href,
			itemType: seoTags.ItemType.EVENTS_PAGE,
			itemData: { slug },
		}).catch(() => null),
	]);
	event = (eventRes as any)?.event ?? null;
	seoTagsServiceConfig = seoRes;
} catch {}

if (!event) {
	return new Response(null, { status: 404 });
}

const isRsvp = event.registration?.initialType !== 'TICKETING';
const gallery = galleryFor(slug, EVENT_GALLERY, 3);
const backendHero = imgSrc(event.mainImage, 1400, 780);
const hero = backendHero || gallery[0];
const formattedDate = event.dateAndTimeSettings?.formatted?.dateAndTime;
const startDate = event.dateAndTimeSettings?.startDate;
const fallbackDate = startDate
	? new Intl.DateTimeFormat('en-GB', { dateStyle: 'full', timeStyle: 'short', timeZone: 'Europe/Kyiv' }).format(new Date(startDate))
	: '';
const description = event.description ?? '';

const eventJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Event',
	name: event.title,
	description: event.shortDescription ?? '',
	startDate: startDate ?? undefined,
	location: { '@type': 'Place', name: event.location?.name ?? 'Warm Shelf Bookstore & Café' },
};
---

<Layout>
	{seoTagsServiceConfig && <SEO.Tags seoTagsServiceConfig={seoTagsServiceConfig} slot="seo-tags" />}
	<main>
		<section class="ev-hero" style={hero ? `background-image: url(${hero})` : ''}>
			<div class="ev-hero-scrim"></div>
			<div class="container ev-hero-inner">
				<a class="back light" href="/events">← All events</a>
				<span class="chip chip-amber">Free · RSVP</span>
				<h1>{event.title}</h1>
				<p class="when">{formattedDate ?? fallbackDate}</p>
				<p class="where">{event.location?.name}</p>
			</div>
		</section>

		<div class="container section ev-body">
			<article class="reveal">
				{event.shortDescription && <p class="lead">{event.shortDescription}</p>}
				{typeof description === 'string' && description && <p class="desc">{description}</p>}

				{gallery.length > 0 && (
					<div class="ev-gallery">
						{gallery.map((g: string, i: number) => (
							<div class={`ev-shot reveal d${i % 3}`}><img src={g} alt={`${event.title} atmosphere`} loading="lazy" /></div>
						))}
					</div>
				)}
			</article>

			<aside class="card rsvp-card">
				<h3>Save your seat</h3>
				<p class="rsvp-note">Entry is free — we just like to know how many chairs and pastries to prepare.</p>
				{isRsvp ? (
					<RsvpForm client:only="react" eventId={event._id} eventTitle={event.title} />
				) : (
					<p class="notice notice-ok">Tickets for this event are sold at the counter — drop by or call us.</p>
				)}
			</aside>
		</div>
	</main>
	<script type="application/ld+json" set:html={JSON.stringify(eventJsonLd)} is:inline />
</Layout>

<style>
	.ev-hero {
		position: relative;
		min-height: 62vh;
		display: flex;
		align-items: flex-end;
		background-size: cover;
		background-position: center;
		background-color: var(--olive-deep);
		color: var(--cream);
	}
	.ev-hero-scrim { position: absolute; inset: 0; background: linear-gradient(to top, rgba(43,35,22,0.9), rgba(43,35,22,0.15) 70%); }
	.ev-hero-inner { position: relative; z-index: 1; padding-top: 3rem; padding-bottom: clamp(2rem, 5vw, 3.5rem); color: var(--cream); }
	.ev-hero-inner h1 { color: var(--cream); max-width: 20ch; margin: 0.7rem 0 0.4rem; }
	.back { display: inline-block; font-size: 0.9rem; text-decoration: none; margin-bottom: 1rem; opacity: 0.85; }
	.back.light { color: var(--cream); }
	.when { font-weight: 600; font-size: 1.1rem; margin: 0; }
	.where { color: rgba(250,246,238,0.85); margin: 0; }

	.ev-body {
		display: grid;
		grid-template-columns: 1.6fr 1fr;
		gap: clamp(1.5rem, 4vw, 3rem);
		align-items: start;
	}
	.lead { font-size: 1.15rem; }
	.desc { color: var(--ink-soft); max-width: 60ch; }

	.ev-gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.9rem; margin-top: 1.8rem; }
	.ev-shot { border-radius: var(--radius-sm); overflow: hidden; }
	.ev-shot img { width: 100%; aspect-ratio: 4/3; object-fit: cover; transition: transform 0.5s ease; }
	.ev-shot:hover img { transform: scale(1.06); }

	.rsvp-card { padding: 1.6rem; position: sticky; top: 90px; }
	.rsvp-card h3 { margin-bottom: 0.4rem; }
	.rsvp-note { color: var(--ink-soft); font-size: 0.92rem; }

	@media (max-width: 820px) {
		.ev-body { grid-template-columns: 1fr; }
		.rsvp-card { position: static; }
		.ev-gallery { grid-template-columns: 1fr 1fr; }
	}
</style>
