---
import { buildLogoutHref, sanitizeReturnToUrl } from "../lib/auth";
import Layout from "../layouts/Layout.astro";

const returnToUrl = sanitizeReturnToUrl(Astro.url.searchParams.get("returnToUrl"));
const logoutAction = buildLogoutHref(returnToUrl);
---

<Layout title="Signing Out | Web Trends & Insights Dashboard">
  <section class="signout-shell">
    <div class="signout-card">
      <p class="signout-eyebrow">Switching accounts</p>
      <h1>Signing you out</h1>
      <p class="signout-copy">
        We’re clearing the current member session so you can continue with a different
        account.
      </p>

      <form id="signout-form" class="signout-form" action={logoutAction} method="post">
        <button class="signout-button signout-button--primary" type="submit">
          Continue
        </button>
      </form>
    </div>
  </section>

  <script>
    const signoutForm = document.getElementById("signout-form");
    if (signoutForm instanceof HTMLFormElement) {
      signoutForm.requestSubmit();
    }
  </script>
</Layout>

<style>
  .signout-shell {
    min-height: calc(100vh - 180px);
    display: grid;
    place-items: center;
    padding: 48px 24px 72px;
  }

  .signout-card {
    width: min(100%, 560px);
    padding: 32px;
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(148, 163, 184, 0.22);
    box-shadow: 0 24px 48px rgba(15, 23, 42, 0.12);
    backdrop-filter: blur(18px);
  }

  .signout-eyebrow {
    margin: 0 0 10px;
    color: rgba(37, 99, 235, 0.9);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: 1.05;
  }

  .signout-copy {
    margin: 16px 0 0;
    color: rgba(15, 23, 42, 0.72);
    font-size: 1rem;
    line-height: 1.65;
  }

  .signout-form {
    margin-top: 28px;
  }

  .signout-button {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 180px;
    padding: 13px 18px;
    border-radius: 999px;
    border: 1px solid rgba(148, 163, 184, 0.24);
    background: rgba(255, 255, 255, 0.82);
    color: rgba(15, 23, 42, 0.88);
    text-decoration: none;
    font-weight: 600;
    box-shadow: 0 14px 30px rgba(15, 23, 42, 0.08);
    cursor: pointer;
  }

  .signout-button--primary {
    background: linear-gradient(135deg, #2563eb 0%, #0ea5e9 100%);
    border-color: transparent;
    color: white;
  }

  @media (prefers-color-scheme: dark) {
    .signout-card {
      background: rgba(15, 23, 42, 0.52);
      border-color: rgba(148, 163, 184, 0.16);
      box-shadow: 0 24px 48px rgba(0, 0, 0, 0.22);
    }

    .signout-copy {
      color: rgba(226, 232, 240, 0.8);
    }

    .signout-button {
      background: rgba(15, 23, 42, 0.75);
      border-color: rgba(148, 163, 184, 0.18);
      color: rgba(244, 247, 255, 0.96);
      box-shadow: 0 16px 32px rgba(0, 0, 0, 0.24);
    }
  }

  @media (max-width: 640px) {
    .signout-shell {
      padding: 24px 16px 48px;
    }

    .signout-card {
      padding: 24px;
    }

    .signout-button {
      width: 100%;
    }
  }
</style>
