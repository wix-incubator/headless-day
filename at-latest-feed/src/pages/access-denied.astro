---
import { buildLoginHref, buildSignOutHref, sanitizeReturnToUrl } from "../lib/auth";
import Layout from "../layouts/Layout.astro";

const returnToUrl = sanitizeReturnToUrl(Astro.url.searchParams.get("returnToUrl"));
const loginHref = `${buildLoginHref(returnToUrl)}&prompt=login`;
const switchAccountHref = buildSignOutHref(loginHref);
---

<Layout title="Access Denied | Web Trends & Insights Dashboard">
  <section class="denied-shell">
    <div class="denied-card">
      <p class="denied-eyebrow">Access restricted</p>
      <h1>This dashboard is limited to <code>@wix.com</code> accounts</h1>
      <p class="denied-copy">
        You successfully reached the sign-in flow, but the account you used is not permitted
        to access this dashboard. Continue with a Wix employee account to try again.
      </p>

      <div class="denied-actions">
        <a class="denied-button denied-button--primary" href={switchAccountHref}>
          Continue with Another Account
        </a>
        <a class="denied-button" href={buildLoginHref(returnToUrl)}>Back to Login</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .denied-shell {
    min-height: calc(100vh - 180px);
    display: grid;
    place-items: center;
    padding: 48px 24px 72px;
  }

  .denied-card {
    width: min(100%, 620px);
    padding: 32px;
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(148, 163, 184, 0.22);
    box-shadow: 0 24px 48px rgba(15, 23, 42, 0.12);
    backdrop-filter: blur(18px);
  }

  .denied-eyebrow {
    margin: 0 0 10px;
    color: rgba(220, 38, 38, 0.9);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: 1.05;
  }

  .denied-copy {
    margin: 16px 0 0;
    color: rgba(15, 23, 42, 0.72);
    font-size: 1rem;
    line-height: 1.65;
  }

  .denied-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 28px;
  }

  .denied-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 200px;
    padding: 13px 18px;
    border-radius: 999px;
    border: 1px solid rgba(148, 163, 184, 0.24);
    background: rgba(255, 255, 255, 0.82);
    color: rgba(15, 23, 42, 0.88);
    text-decoration: none;
    font-weight: 600;
    box-shadow: 0 14px 30px rgba(15, 23, 42, 0.08);
  }

  .denied-button--primary {
    background: linear-gradient(135deg, #2563eb 0%, #0ea5e9 100%);
    border-color: transparent;
    color: white;
  }

  @media (prefers-color-scheme: dark) {
    .denied-card {
      background: rgba(15, 23, 42, 0.52);
      border-color: rgba(148, 163, 184, 0.16);
      box-shadow: 0 24px 48px rgba(0, 0, 0, 0.22);
    }

    .denied-copy {
      color: rgba(226, 232, 240, 0.8);
    }

    .denied-button {
      background: rgba(15, 23, 42, 0.75);
      border-color: rgba(148, 163, 184, 0.18);
      color: rgba(244, 247, 255, 0.96);
      box-shadow: 0 16px 32px rgba(0, 0, 0, 0.24);
    }
  }

  @media (max-width: 640px) {
    .denied-shell {
      padding: 24px 16px 48px;
    }

    .denied-card {
      padding: 24px;
    }

    .denied-actions {
      flex-direction: column;
    }

    .denied-button {
      width: 100%;
    }
  }
</style>
