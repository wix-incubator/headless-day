---
import {
  buildLoginHref,
  buildLogoutHref,
  hasAllowedWixMemberSession,
  hasMemberSession,
  sanitizeReturnToUrl,
} from "../lib/auth";
import Layout from "../layouts/Layout.astro";

const returnToUrl = sanitizeReturnToUrl(Astro.url.searchParams.get("returnToUrl"));
const deniedReason = Astro.url.searchParams.get("denied");
const hasMemberCookie = hasMemberSession(Astro.cookies);
const isLoggedIn = hasMemberCookie && (await hasAllowedWixMemberSession(Astro.cookies));
const isDeniedForDomain = deniedReason === "domain";
const isDisallowedMember = hasMemberCookie && !isLoggedIn;
const loginPageHref = buildLoginHref(returnToUrl, isDeniedForDomain ? "domain" : undefined);
const loginHref = `/api/auth/login?returnToUrl=${encodeURIComponent(returnToUrl)}&prompt=login`;
const logoutHref = buildLogoutHref(returnToUrl);
const switchAccountHref = buildLogoutHref(loginPageHref);
---

<Layout title="Login | Web Trends & Insights Dashboard">
  <section class="login-shell">
    <div class="login-card">
      <p class="login-eyebrow">Member access</p>
      <h1>
        {isDisallowedMember || isDeniedForDomain
          ? "This dashboard is limited to @wix.com accounts"
          : isLoggedIn
            ? "You're already signed in"
            : "Sign in with your Wix account"}
      </h1>
      <p class="login-copy">
        {isDisallowedMember
          ? "You signed in successfully, but this site only allows Wix employee accounts. Sign out and continue with a @wix.com account."
          : isDeniedForDomain
            ? "Only @wix.com accounts can access this dashboard. Continue with a Wix employee account to proceed."
            : isLoggedIn
              ? "Continue back to the dashboard or sign out to switch accounts."
              : "Use the secure Wix-hosted sign-in flow to start a member session for this dashboard."}
      </p>

      <div class="login-actions">
        {isDisallowedMember ? (
          <>
            <form class="login-action-form" action={switchAccountHref} method="post">
              <button class="login-button login-button--primary" type="submit">
                Sign Out and Switch Account
              </button>
            </form>
          </>
        ) : isLoggedIn ? (
          <>
            <a class="login-button login-button--primary" href={returnToUrl}>Continue</a>
            <form class="login-action-form" action={logoutHref} method="post">
              <button class="login-button" type="submit">Logout</button>
            </form>
          </>
        ) : (
          <a class="login-button login-button--primary" href={loginHref}>Continue to Login</a>
        )}
      </div>
    </div>
  </section>
</Layout>

<style>
  .login-shell {
    min-height: calc(100vh - 180px);
    display: grid;
    place-items: center;
    padding: 48px 24px 72px;
  }

  .login-card {
    width: min(100%, 560px);
    padding: 32px;
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(148, 163, 184, 0.22);
    box-shadow: 0 24px 48px rgba(15, 23, 42, 0.12);
    backdrop-filter: blur(18px);
  }

  .login-eyebrow {
    margin: 0 0 10px;
    color: rgba(37, 99, 235, 0.9);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: 1.05;
  }

  .login-copy {
    margin: 16px 0 0;
    color: rgba(15, 23, 42, 0.72);
    font-size: 1rem;
    line-height: 1.65;
  }

  .login-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 28px;
  }

  .login-action-form {
    margin: 0;
  }

  .login-button {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 180px;
    padding: 13px 18px;
    border-radius: 999px;
    border: 1px solid rgba(148, 163, 184, 0.24);
    background: rgba(255, 255, 255, 0.82);
    color: rgba(15, 23, 42, 0.88);
    text-decoration: none;
    font-weight: 600;
    box-shadow: 0 14px 30px rgba(15, 23, 42, 0.08);
    cursor: pointer;
  }

  .login-button--primary {
    background: linear-gradient(135deg, #2563eb 0%, #0ea5e9 100%);
    border-color: transparent;
    color: white;
  }

  @media (prefers-color-scheme: dark) {
    .login-card {
      background: rgba(15, 23, 42, 0.52);
      border-color: rgba(148, 163, 184, 0.16);
      box-shadow: 0 24px 48px rgba(0, 0, 0, 0.22);
    }

    .login-copy {
      color: rgba(226, 232, 240, 0.8);
    }

    .login-button {
      background: rgba(15, 23, 42, 0.75);
      border-color: rgba(148, 163, 184, 0.18);
      color: rgba(244, 247, 255, 0.96);
      box-shadow: 0 16px 32px rgba(0, 0, 0, 0.24);
    }
  }

  @media (max-width: 640px) {
    .login-shell {
      padding: 24px 16px 48px;
    }

    .login-card {
      padding: 24px;
    }

    .login-actions {
      flex-direction: column;
    }

    .login-button {
      width: 100%;
    }
  }
</style>
