        if(type!=='tile'){var topY=type==='plate'?wy+h:wy+BH;for(var i=0;i<w;i++)for(var j=0;j<d;j++)addStud(wx+i+0.5,wz+j+0.5,topY);}
      }else if(type==='round'){var cyl=new THREE.Mesh(new THREE.CylinderGeometry(0.47,0.47,BH*0.96,16),mat());cyl.position.set(wx+0.5,wy+BH/2,wz+0.5);g.add(cyl);addStud(wx+0.5,wz+0.5,wy+BH);
      }else if(type==='cone'){var cn=new THREE.Mesh(new THREE.ConeGeometry(0.6,BH*1.5,18),mat());cn.position.set(wx+0.5,wy+BH*0.75,wz+0.5);g.add(cn);
      }else if(type==='dome'){var sph=new THREE.Mesh(new THREE.SphereGeometry(0.52,16,12),mat());sph.position.set(wx+0.5,wy+BH*0.4,wz+0.5);g.add(sph);
      }else if(type==='slope'){var sub=new THREE.Group();var wedge=new THREE.Mesh(wedgeGeom(),new THREE.MeshLambertMaterial({color:hex,side:THREE.DoubleSide}));wedge.position.set(-0.5,0,-0.5);sub.add(wedge);sub.position.set(wx+0.5,wy,wz+0.5);sub.rotation.y=(rot||0)*Math.PI/2;g.add(sub);
      }else if(type==='arch'){var legL=new THREE.Mesh(new THREE.BoxGeometry(0.96,BH*0.96,d*0.96),mat());legL.position.set(wx+0.5,wy+BH/2,wz+d/2);g.add(legL);var legR=new THREE.Mesh(new THREE.BoxGeometry(0.96,BH*0.96,d*0.96),mat());legR.position.set(wx+2.5,wy+BH/2,wz+d/2);g.add(legR);var lint=new THREE.Mesh(new THREE.BoxGeometry(3*0.96,BH*0.42,d*0.96),mat());lint.position.set(wx+1.5,wy+BH*0.79,wz+d/2);g.add(lint);}
      return g;}

    /* standalone tumbling brick (reel-style scattered bricks) */
    function makeBrick(w,d,hex){
      var g=new THREE.Group(),u=2.9,h=u*1.15,m=new THREE.MeshLambertMaterial({color:hex});
      var box=new THREE.Mesh(new THREE.BoxGeometry(w*u,h,d*u),m);g.add(box);
      var sr=u*0.29,sh=u*0.26;
      for(var i=0;i<w;i++)for(var j=0;j<d;j++){var s=new THREE.Mesh(new THREE.CylinderGeometry(sr,sr,sh,12),m);
        s.position.set((i-(w-1)/2)*u,h/2+sh/2,(j-(d-1)/2)*u);g.add(s);}
      return g;
    }

    var wrap=document.getElementById('hero-canvas');
    var scene=new THREE.Scene();
    var camera=new THREE.PerspectiveCamera(40,1,0.1,1000);
    var renderer=new THREE.WebGLRenderer({antialias:true,alpha:true});
    renderer.setPixelRatio(Math.min(devicePixelRatio,1.5));
    wrap.appendChild(renderer.domElement);
    scene.add(new THREE.AmbientLight(0xffffff,0.86));
    var dl=new THREE.DirectionalLight(0xffffff,0.9);dl.position.set(16,26,14);scene.add(dl);
    var dl2=new THREE.DirectionalLight(0xbcd4ff,0.32);dl2.position.set(-14,10,-12);scene.add(dl2);
    var rim=new THREE.DirectionalLight(0xffd98a,0.25);rim.position.set(-6,4,18);scene.add(rim);

    var pivot=new THREE.Group();scene.add(pivot);
    var pieces=mansionPieces(),total=pieces.length;
    var MATS=[];
    var groups=[];
    /* --- Recolour system (inspired by the LEGO recolour engine): reskin every brick --- */
    var PALS=[PAL,
      {sand:0x6E8B5E,ivory:0xF2ECDD,slate:0xB0563A,slateDk:0x8E4531,gold:0xE0B24A,wood:0x4A3320,glass:0xCFE0D8,lawn:0x74BC67,stone:0x5C7650},
      {sand:0x4E6E8C,ivory:0xEFF3F5,slate:0x2C3A4C,slateDk:0x222D3B,gold:0xE0B24A,wood:0x3A4A58,glass:0xBFD9EA,lawn:0x74BC67,stone:0x3F5B74},
      {sand:0xE0A32E,ivory:0xFFFFFF,slate:0xC0392B,slateDk:0x9E2E22,gold:0xF4D03F,wood:0x7A5230,glass:0xBFE0F2,lawn:0x74BC67,stone:0xC98A22},
      {sand:0x7C5CA6,ivory:0xF3EEF7,slate:0x3E2E5C,slateDk:0x2E2246,gold:0xF4D03F,wood:0x4A3A5E,glass:0xD8C8EC,lawn:0x74BC67,stone:0x5E4886}];
    var palI=0;
    function setTheme(i){palI=i;var np=PALS[i];MATS.forEach(function(m){var hex=np[m.userData.role];if(hex!=null)m.color.setHex(hex);});}
    window.brickify={setWall:function(hex){MATS.forEach(function(m){if(m.userData.role==='sand')m.color.setHex(hex);});}};

    /* auto-fit framing on the real building bounds (robust to any size) */
    var CEN=new THREE.Vector3(),R=12,DIR=new THREE.Vector3(0.6,0.42,1).normalize();
    /* scattered tumbling bricks around the mansion */
    var BC=[0xD01012,0xFDC400,0x0057A6,0x2FA84F,0xF0541E,0x8E44AD,0x00A6A0,0xFDC400];
    var BSPEC=[[2,4],[2,2],[1,3],[2,3],[1,4],[2,2],[1,2],[2,4]];
    var bricks3d=[];
    function buildBricks(){
      var scx=CEN.x-R*1.85;   /* approximate on-screen centre after the pan */
      for(var bi=0;bi<8;bi++){var sp=BSPEC[bi],br=makeBrick(sp[0],sp[1],BC[bi]);
        var frac=bi/7;
        br.position.set(scx-R*(1.5+frac*1.7), CEN.y+Math.sin(bi*2.5+0.6)*R*1.5, CEN.z+(bi%2?11:-5));
        br.rotation.set(Math.random()*3,Math.random()*3,Math.random()*3);
        br.userData={sx:(Math.random()-0.5)*0.012,sy:(Math.random()-0.5)*0.014,sz:(Math.random()-0.5)*0.01,bob:Math.random()*6.28,by:br.position.y};
        scene.add(br);bricks3d.push(br);}
    }
    function place(mx,my,sp){
      var vfov=camera.fov*Math.PI/180;
      var mf=2*Math.atan(Math.tan(vfov/2)*Math.min(1,camera.aspect||1));
      var dist=(R/Math.sin(mf/2))*1.7;   /* zoom out so the whole mansion fits */
      var panX=R*1.85;   /* on the right, but fully in frame (not clipped) */
      camera.position.copy(CEN).addScaledVector(DIR,dist);
      camera.position.x+=-panX+mx*R*0.16; camera.position.y+=my*R*0.10 - sp*R*0.22;
      camera.lookAt(CEN.x-panX, CEN.y-sp*R*0.18, CEN.z);
    }
    function resize(){var w=wrap.clientWidth,h=wrap.clientHeight||1;renderer.setSize(w,h);camera.aspect=w/h;camera.updateProjectionMatrix();}

    /* Build the ~1,500 mansion meshes in short time-sliced batches so no single
       task blocks the main thread >50ms (keeps TBT low / no long tasks). */
    var _gi=0;
    function buildChunk(){
      var t0=(performance.now?performance.now():Date.now());
      while(_gi<pieces.length && ((performance.now?performance.now():Date.now())-t0)<22){
        var p=pieces[_gi];
        var g=buildGroup(p.type,p.x,p.z,p.y,p.w,p.d,PAL[p.color],p.rot);
        g.traverse(function(o){if(o.material){o.material.userData=o.material.userData||{};o.material.userData.role=p.color;MATS.push(o.material);}});
        g.visible=false;pivot.add(g);groups.push(g);_gi++;
      }
      if(_gi<pieces.length)requestAnimationFrame(buildChunk);
      else finishSetup();
    }
    function finishSetup(){
      (function(){var box=new THREE.Box3().setFromObject(pivot);var s=box.getBoundingSphere(new THREE.Sphere());CEN.copy(s.center);R=s.radius;})();
      buildBricks();
      resize();addEventListener('resize',resize);
      ready=true;
      pivot.rotation.set(0,baseRot+0.4,0);place(0,0,0);renderer.render(scene,camera);
      if(reduce){for(var k=0;k<groups.length;k++)groups[k].visible=true;}
      else{running=true;requestAnimationFrame(frame);}
    }

    var tmx=0,tmy=0,mx=0,my=0,scrollY=0;
    /* render-on-demand: after the intro the loop STOPS so the page can reach
       idle (otherwise a perpetual rAF pins the main thread → huge TBT). Any
       interaction wakes it for a short, self-settling burst. */
    var running=false,settleUntil=0,ready=false;
    function wake(ms){settleUntil=Math.max(settleUntil,(performance.now()||Date.now())+(ms||480));
