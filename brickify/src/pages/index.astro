        b.rotation.x+=u.sx;b.rotation.y+=u.sy;b.rotation.z+=u.sz;
        b.position.y=u.by+Math.sin(now*0.001+u.bob)*1.3;}
      place(mx,my,sp);
      renderer.render(scene,camera);
      if(intro||now<settleUntil){requestAnimationFrame(frame);}
      else{running=false;}   /* idle → stop; page can settle, TBT stays low */
    }
    /* kick off the time-sliced build; finishSetup() does the first render + starts the loop */
