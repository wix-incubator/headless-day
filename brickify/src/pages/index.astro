    var tbtns=document.querySelectorAll('#themes .theme');
    tbtns.forEach(function(b){b.addEventListener('click',function(){setTheme(+b.getAttribute('data-i'));tbtns.forEach(function(x){x.classList.remove('on');});b.classList.add('on');});});
    } /* end init3D */
  })();
  </script>
</Base>

<style>
  /* ---------- scroll progress ---------- */
  #progress{position:fixed;top:0;left:0;right:0;height:4px;z-index:60;transform:scaleX(0);transform-origin:0 50%;
    background:linear-gradient(90deg,var(--brick-red),var(--brick-yellow),var(--brick-green),var(--brick-blue));}

  /* ---------- nav ---------- */
  /* realistic raised-stud baseplate */
  .baseplate{position:fixed;inset:0;z-index:-1;pointer-events:none;
    background:
      radial-gradient(circle at 44% 40%, rgba(255,255,255,.55) 0 3px, transparent 4px) 0 0/40px 40px,
      radial-gradient(circle at 50% 54%, rgba(255,255,255,.16) 0 11px, transparent 12px) 0 0/40px 40px,
      radial-gradient(circle at 50% 68%, rgba(0,0,0,.14) 0 12px, transparent 13px) 0 0/40px 40px,
      #C7C9CC;}
  :global(body.night) .baseplate{
    background:
      radial-gradient(circle at 44% 40%, rgba(255,255,255,.10) 0 3px, transparent 4px) 0 0/40px 40px,
      radial-gradient(circle at 50% 54%, rgba(255,255,255,.05) 0 11px, transparent 12px) 0 0/40px 40px,
      radial-gradient(circle at 50% 68%, rgba(0,0,0,.55) 0 12px, transparent 13px) 0 0/40px 40px,
      #1b2230;}
  .topbar{position:absolute;top:0;left:0;right:0;z-index:20;background:none;border:0;box-shadow:none;}
  .nav{display:flex;align-items:center;justify-content:space-between;padding:1.1rem 0;position:relative;z-index:20;}
  .brand{font-family:var(--font-display);font-weight:700;font-size:1.5rem;}
  .brand span{color:var(--brick-red);}
  .nav-links{display:flex;align-items:center;gap:1.4rem;}
  .nav-links a{font-family:var(--font-display);font-weight:600;color:var(--color-muted);transition:color .15s;}
  .nav-links a:hover{color:var(--color-ink);}
  .nav-links .btn{color:#fff;}
  @media(max-width:720px){.nav-links a:not(.btn){display:none;}}

  /* ---------- hero ---------- */
  .hero{position:relative;min-height:92vh;display:flex;align-items:center;overflow:hidden;}
  .hero-bg{position:absolute;inset:-14%;z-index:0;opacity:.9;will-change:transform;transform:translateZ(0);
    background:radial-gradient(120% 90% at 78% 30%, #FFE9A8 0%, rgba(255,233,168,0) 55%),
      radial-gradient(90% 80% at 12% 80%, #BFE3FF 0%, rgba(191,227,255,0) 60%),
      radial-gradient(100% 100% at 90% 90%, #CDEFD5 0%, rgba(205,239,213,0) 55%),
      var(--color-bg);
    animation:drift 18s ease-in-out infinite;}
  /* transform-only so the browser can composite it (no background-position paint) */
  @keyframes drift{0%,100%{transform:translate3d(0,0,0) scale(1)}50%{transform:translate3d(2.5%,2%,0) scale(1.04)}}
  #hero-canvas{position:absolute;inset:0;z-index:1;}
  .floaties{position:absolute;inset:0;z-index:1;pointer-events:none;}
  .fl{position:absolute;width:calc(34px*var(--s,1));height:calc(20px*var(--s,1));background:var(--c);border-radius:5px;
    border:2px solid rgba(0,0,0,.22);box-shadow:inset 0 -6px 0 rgba(0,0,0,.18);opacity:.5;
    animation:floaty 7s ease-in-out infinite;animation-delay:var(--d,0s);}
  .fl::after{content:"";position:absolute;top:4px;left:8px;right:8px;height:7px;background:radial-gradient(circle at 6px 3px,rgba(255,255,255,.5) 4px,transparent 4.5px) 0 0/16px 7px;}
  @keyframes floaty{0%,100%{transform:translateY(0) rotate(-6deg)}50%{transform:translateY(-24px) rotate(6deg)}}
  .hero-copy{position:relative;z-index:3;max-width:600px;}
  .hero-copy h1{margin-top:.5rem;font-size:clamp(2.8rem,6.5vw,5.2rem);text-shadow:0 2px 0 rgba(255,255,255,.55);}
  .hl{background:linear-gradient(100deg,var(--brick-red),#F0541E 60%,var(--brick-yellow));-webkit-background-clip:text;background-clip:text;color:transparent;}
  .hero-copy .lede{font-size:var(--fs-lg);color:var(--color-muted);margin:1.1rem 0 1.7rem;max-width:38ch;}
  .hero-cta{display:flex;flex-wrap:wrap;gap:.8rem;}
  .ghost{background:var(--color-surface);color:var(--color-ink);border:1px solid var(--color-line);box-shadow:0 4px 16px rgba(0,0,0,.16);}
  .themes{margin-top:1.1rem;display:flex;align-items:center;gap:.6rem;}
  .themes .tlabel{font-family:var(--font-display);font-weight:600;font-size:.85rem;color:var(--color-muted);}
  .theme{width:34px;height:34px;border-radius:10px;cursor:pointer;padding:0;position:relative;
    border:2px solid var(--n-900);background:linear-gradient(135deg,var(--a) 0 50%,var(--b) 50% 100%);
    box-shadow:inset 0 -4px 0 rgba(0,0,0,.22),2px 2px 0 rgba(0,0,0,.14);
    transition:transform .12s ease, box-shadow .12s ease;}
  .theme::after{content:"";position:absolute;top:5px;left:7px;width:8px;height:8px;border-radius:50%;background:rgba(255,255,255,.55);}
  .theme:hover{transform:translateY(-3px) rotate(-4deg);}
  .theme.on{outline:3px solid var(--brick-blue);outline-offset:2px;}
  .wheel{width:34px;height:34px;border-radius:50%;cursor:pointer;padding:0;appearance:none;-webkit-appearance:none;border:2px solid var(--n-900);
    background:conic-gradient(red,#ff8000,gold,#7CFC00,#00E5A0,#00BFFF,#0057A6,#8E44AD,magenta,red);
    box-shadow:2px 2px 0 rgba(0,0,0,.14);transition:transform .12s ease;}
  .wheel:hover{transform:scale(1.12) rotate(20deg);}
  .theme-toggle{background:none;border:0;cursor:pointer;font-size:1.2rem;line-height:1;padding:.2em;border-radius:8px;transition:transform .12s ease;}
  .theme-toggle:hover{transform:scale(1.2) rotate(-10deg);}
