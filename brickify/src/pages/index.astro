    addEventListener('pointermove',function(e){tmx=(e.clientX/innerWidth)*2-1;tmy=(e.clientY/innerHeight)*2-1;wake(480);});
    addEventListener('scroll',function(){scrollY=window.scrollY||0;wake(480);},{passive:true});

    var DUR=3400,start=null,baseRot=-0.5;
