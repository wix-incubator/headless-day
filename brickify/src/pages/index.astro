    function buildGroup(type,x,z,y,w,d,hex,rot){
      var g=new THREE.Group();var wx=x-SB.SX/2,wy=y*BH,wz=z-SB.SZ/2;
      function mat(){return new THREE.MeshLambertMaterial({color:hex});}
      function addStud(cx,cz,topY){var s=new THREE.Mesh(new THREE.CylinderGeometry(SR,SR,SH,10),mat());s.position.set(cx,topY+SH/2,cz);g.add(s);}
      if(type==='brick'||type==='tile'||type==='plate'){var h=type==='plate'?BH*0.36:BH*0.96;var cy=type==='plate'?wy+h/2:wy+BH/2;
