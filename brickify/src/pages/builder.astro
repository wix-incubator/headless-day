    const ox=Math.floor((GRID-(maxx-minx))/2)-minx, oz=Math.floor((GRID-(maxz-minz))/2)-minz;
    list.forEach(p=>{const gx=ox+p.x,gz=oz+p.z;if(footprintFree(gx,gz,p.y,p.w,p.d))addPiece(gx,gz,p.y,p.w,p.d,p.color,p.fam,false,p.rot);});
