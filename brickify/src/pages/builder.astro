  function addPiece(x,z,y,w,d,color,fam,record,rot){
    rot=rot||0; const des=deriveMeta(fam,w,d), hex=CMAP[color]?CMAP[color].hex:0x999999;
    const built=buildGroup(fam,x,z,y,w,d,hex,rot);
    const id=nextId++; built.picks.forEach(m=>{m.userData.id=id;pickables.push(m);});
    scene.add(built.group);
    const b={id:id,x:x,z:z,y:y,w:w,d:d,color:color,hex:hex,fam:fam,rot:rot,pid:des.id,name:des.name,price:des.price,group:built.group,picks:built.picks};
    placed.push(b);byId[id]=b;
    for(let a=0;a<w;a++)for(let c2=0;c2<d;c2++)occ.add(ck(x+a,y,z+c2));
