  // ---- templates ----
  const CAT=[[2,8],[2,6],[2,4],[2,3],[2,2],[1,8],[1,6],[1,4],[1,3],[1,2],[1,1]];
  function tile(A,B,cell){const cov=Array.from({length:A},()=>new Array(B).fill(false));const out=[];
    for(let a=0;a<A;a++)for(let b=0;b<B;b++){const c=cell(a,b);if(!c||cov[a][b])continue;let done=false;
      for(const[bw,bd]of CAT){for(const[w,d]of(bw===bd?[[bw,bd]]:[[bw,bd],[bd,bw]])){
        if(a+w>A||b+d>B)continue;let ok=true;for(let da=0;da<w&&ok;da++)for(let db=0;db<d&&ok;db++)if(cell(a+da,b+db)!==c||cov[a+da][b+db])ok=false;
        if(!ok)continue;for(let da=0;da<w;da++)for(let db=0;db<d;db++)cov[a+da][b+db]=true;out.push({a,b,w,d,c});done=true;break;}if(done)break;}}
    return out;}
  const SB={SX:11,SZ:8,fh:5,wallTop:15,mTop:19,cap:21};
  const isPil=x=>(x===0||x===3||x===7||x===10);
  function cellAt(x,y,z){var SX=SB.SX,SZ=SB.SZ,fh=SB.fh,wallTop=SB.wallTop,mTop=SB.mTop,cap=SB.cap;
    var onX0=x===0,onX1=x===SX-1,onZ0=z===0,onZ1=z===SZ-1;
    if(y>=wallTop-1&&y<=cap&&((x>=1&&x<=2)||(x>=8&&x<=9))&&z>=5&&z<=6)return (y>=cap-1?'darkGray':'stoneGray');
    if(y<wallTop){if(!(onX0||onX1||onZ0||onZ1))return null;var fl=Math.floor(y/fh),yin=y%fh;
      if(y===0)return 'darkGray';if(onZ0&&fl===0&&x>=4&&x<=6&&yin===fh-1)return null;if(yin===fh-1)return 'stoneLight';
      if(onZ0){if(isPil(x))return 'stoneLight';if(fl===0&&x>=4&&x<=6&&yin>=1&&yin<=3)return 'blue';if(yin>=1&&yin<=3)return 'tan';return 'stoneGray';}
      if(onX0||onX1){if(z>=2&&z<=SZ-3&&yin>=1&&yin<=3&&(((z-2)%2)===0))return 'tan';return 'stoneGray';}
      if(onZ1){if(x>=2&&x<=SX-3&&yin>=1&&yin<=3&&(((x-2)%2)===0))return 'tan';return 'stoneGray';}
      return 'stoneGray';}
    if(y<=mTop-1){if(!(onX0||onX1||onZ0||onZ1))return null;
      if(onZ0){var cx=5,dx=x-cx,dy=y-16,dist=Math.sqrt(dx*dx+dy*dy);
        if(dist<=3.0){if(dist<=0.7)return 'red';if(dist>=2.4)return 'red';if(dx===0||dy===0)return 'red';return 'glass';}
        if((x===1||x===9)&&y>=16&&y<=17)return 'tan';return 'roofGreen';}
      return 'roofGreen';}
    var r=y-mTop,ins=r+1;
    if(x>=ins&&x<=SX-1-ins&&z>=ins&&z<=SZ-1-ins){if(x===ins||x===SX-1-ins||z===ins||z===SZ-1-ins)return 'roofGreenDk';return 'roofGreen';}
    return null;}
  function generateSanctum(){
    // Sanctum Sanctorum — grey stone corner building, tan bay windows, arched
    // entrance, big radiating round "Eye" window, dark-green mansard roof.
    const SX=13,SZ=11,fh=4,floors=4,wallTop=floors*fh,cx=6; // walls Y1..16
    const P=[]; const add=(x,y,z,w,d,color,fam,rot)=>P.push({x:x,y:y,z:z,w:w,d:d,color:color,fam:fam||'brick',rot:rot||0});
    const cell=new Map(); const K=(x,y,z)=>x+'|'+y+'|'+z;
    const put=(x,y,z,color,fam,rot)=>cell.set(K(x,y,z),{x:x,y:y,z:z,w:1,d:1,color:color,fam:fam||'brick',rot:rot||0});
    const onB=(x,z)=>(x===0||x===SX-1||z===0||z===SZ-1);
    const isCorner=(x,z)=>((x===0||x===SX-1)&&(z===0||z===SZ-1));
    // --- display base + gold nameplate ---
    for(let x=-1;x<=SX;x++)for(let z=-1;z<=SZ;z++)add(x,0,z,1,1,'black','tile');
    for(let x=cx-2;x<=cx+2;x++)add(x,0,-1,1,1,'amber','tile');
    // --- stone shell: quoined corners + cornice band per floor ---
    for(let Y=1;Y<=wallTop;Y++){const yin=(Y-1)%fh;
      for(let x=0;x<SX;x++)for(let z=0;z<SZ;z++){ if(!onB(x,z))continue;
        let c='stoneGray';
        if(yin===fh-1) c='stoneLight';                 // cornice band
        if(isCorner(x,z)) c=(Y%2?'stoneLight':'stoneGray'); // quoins
        put(x,Y,z,c,'brick'); }}
    // --- tan-framed windows (2 tall) in bays on every floor & wall ---
    const winPair=(x,z,f)=>{const Y=f*fh+1;put(x,Y,z,'tan','window');put(x,Y+1,z,'tan','window');};
    [1,2,3].forEach(f=>[2,4,8,10].forEach(x=>winPair(x,0,f)));       // front
    [2,10].forEach(x=>winPair(x,0,0));                                // front ground (flank door)
    [0,1,2,3].forEach(f=>[3,5,7].forEach(z=>{winPair(0,z,f);winPair(SX-1,z,f);})); // sides
    [1,2,3].forEach(f=>[2,4,8,10].forEach(x=>winPair(x,SZ-1,f)));    // back
    // --- arched entrance (blue door + stone jambs + arch head) ---
    put(cx,1,0,'blue','door');put(cx,2,0,'blue','door');put(cx,3,0,'blue','door');
    [cx-1,cx+1].forEach(x=>{put(x,1,0,'stoneLight','brick');put(x,2,0,'stoneLight','brick');put(x,3,0,'stoneLight','brick');});
    add(cx-1,4,0,3,1,'stoneLight','arch');
    // --- big radiating round "Eye / Seal" window high on the front ---
    const Yc=wallTop-3;
    for(let x=1;x<=SX-2;x++)for(let Y=Yc-3;Y<=Yc+3;Y++){const dx=x-cx,dy=Y-Yc,dist=Math.sqrt(dx*dx+dy*dy);
      if(dist>2.95)continue; let c;
      if(dist>=2.35) c='darkGray';                                    // dark outer frame ring
      else if(dist<=0.8) c='amber';                                   // glowing hub
      else if(dx===0||dy===0||Math.abs(dx)===Math.abs(dy)) c='amber'; // radiating gold spokes
      else c='glass';
      put(x,Y,0,c,'brick'); }
    cell.forEach(v=>P.push(v));
    // --- cornice overhang ring ---
    for(let x=-1;x<=SX;x++){add(x,wallTop,-1,1,1,'stoneLight','tile');add(x,wallTop,SZ,1,1,'stoneLight','tile');}
    for(let z=0;z<SZ;z++){add(-1,wallTop,z,1,1,'stoneLight','tile');add(SX,wallTop,z,1,1,'stoneLight','tile');}
    // --- dark-green mansard roof: inset sloped rings + tiled cap ---
    const mB=wallTop+1;
    for(let L=0;L<3;L++){const Y=mB+L,ins=L,x0=ins,x1=SX-1-ins,z0=ins,z1=SZ-1-ins;
      for(let x=x0;x<=x1;x++)for(let z=z0;z<=z1;z++){const edge=(x===x0||x===x1||z===z0||z===z1);if(!edge)continue;
        if(z===z0)add(x,Y,z,1,1,'roofGreen','slope',0);
        else if(z===z1)add(x,Y,z,1,1,'roofGreenDk','slope',2);
        else if(x===x0)add(x,Y,z,1,1,'roofGreen','slope',1);
        else add(x,Y,z,1,1,'roofGreen','slope',3);
      }}
    for(let x=3;x<=SX-4;x++)for(let z=3;z<=SZ-4;z++)add(x,mB+3,z,1,1,'roofGreenDk','tile');
    // --- chimneys + pots ---
    [[2,SZ-3],[SX-3,SZ-3]].forEach(c=>{for(let k=0;k<4;k++)add(c[0],wallTop+1+k,c[1],1,1,'reddishBrown','brick');add(c[0],wallTop+5,c[1],1,1,'darkGray','round');});
    return P;
  }
  function generateVilla(){
    // Original "Brick Villa" — cream walls, red quoins, sand bands, blue-glass
    // window bays, arched blue door, red mansard roof, spire + chimney.
    const W=11,D=9,fh=4,floors=3,wallTop=floors*fh,cx=Math.floor(W/2);
    const P=[]; const add=(x,y,z,w,d,color,fam,rot)=>P.push({x:x,y:y,z:z,w:w,d:d,color:color,fam:fam||'brick',rot:rot||0});
    const cell=new Map(); const K=(x,y,z)=>x+'|'+y+'|'+z;
    const put=(x,y,z,color,fam,rot)=>cell.set(K(x,y,z),{x:x,y:y,z:z,w:1,d:1,color:color,fam:fam||'brick',rot:rot||0});
    const onB=(x,z)=>(x===0||x===W-1||z===0||z===D-1);
    const corner=(x,z)=>((x===0||x===W-1)&&(z===0||z===D-1));
    // stone shell: red plinth, sand floor-bands, quoined corners
    for(let Y=1;Y<=wallTop;Y++){const yin=(Y-1)%fh;
      for(let x=0;x<W;x++)for(let z=0;z<D;z++){ if(!onB(x,z))continue;
        let c='cream';
        if(Y===1)c='red'; else if(yin===fh-1)c='sand';
        if(corner(x,z))c=(Y%2?'red':'sand');
        put(x,Y,z,c,'brick'); }}
    // windows — tan-framed, 2 tall
    const win=(x,z,f)=>{const Y=f*fh+2;put(x,Y,z,'tan','window');put(x,Y+1,z,'tan','window');};
    [1,2].forEach(f=>[2,cx,W-3].forEach(x=>win(x,0,f)));
    [2,W-3].forEach(x=>win(x,0,0));
    [0,1,2].forEach(f=>[2,5].forEach(z=>{if(z<D-1){win(0,z,f);win(W-1,z,f);}}));
    [0,1,2].forEach(f=>[2,cx,W-3].forEach(x=>win(x,D-1,f)));
    // arched entrance
    put(cx,1,0,'blue','door');put(cx,2,0,'blue','door');put(cx,3,0,'blue','door');
    [K(cx-1,4,0),K(cx,4,0),K(cx+1,4,0)].forEach(k=>cell.delete(k));
    cell.forEach(v=>P.push(v));
    add(cx-1,4,0,3,1,'sand','arch');
    // cornice overhang
    for(let x=-1;x<=W;x++){add(x,wallTop,-1,1,1,'sand','tile');add(x,wallTop,D,1,1,'sand','tile');}
    for(let z=0;z<D;z++){add(-1,wallTop,z,1,1,'sand','tile');add(W,wallTop,z,1,1,'sand','tile');}
    // red mansard roof
    const mB=wallTop+1;
    for(let L=0;L<3;L++){const Y=mB+L,ins=L,x0=ins,x1=W-1-ins,z0=ins,z1=D-1-ins;
      for(let x=x0;x<=x1;x++)for(let z=z0;z<=z1;z++){const edge=(x===x0||x===x1||z===z0||z===z1);if(!edge)continue;
        if(z===z0)add(x,Y,z,1,1,'darkRed','slope',0);
        else if(z===z1)add(x,Y,z,1,1,'darkRed','slope',2);
        else if(x===x0)add(x,Y,z,1,1,'darkRed','slope',1);
        else add(x,Y,z,1,1,'darkRed','slope',3);
      }}
    for(let x=2;x<=W-3;x++)for(let z=2;z<=D-3;z++)add(x,mB+3,z,1,1,'red','tile');
    // spire + chimney
    const fx=Math.floor(W/2),fz=Math.floor(D/2);
    add(fx,mB+3,fz,1,1,'yellow','round');add(fx,mB+4,fz,1,1,'blue','cone');
    add(1,mB,D-2,1,1,'tan','brick');add(1,mB+1,D-2,1,1,'tan','brick');add(1,mB+2,D-2,1,1,'red','round');
    return P;
  }
  function loadVilla(){clearAll(true);const list=generateVilla();
