  const ray=new THREE.Raycaster();const ndc=new THREE.Vector2();
  function pick(ev){
    const r=renderer.domElement.getBoundingClientRect();
    ndc.x=((ev.clientX-r.left)/r.width)*2-1; ndc.y=-((ev.clientY-r.top)/r.height)*2+1;
    ray.setFromCamera(ndc,camera);
    const hits=ray.intersectObjects(pickables,false);
    if(!hits.length)return null;
    const h=hits[0]; let cx,cz,layer;
    if(h.object.userData.base){cx=Math.floor(h.point.x+GRID/2);cz=Math.floor(h.point.z+GRID/2);layer=0;}
    else{const b=byId[h.object.userData.id];if(!b)return null;
      const n=h.face?h.face.normal.clone().transformDirection(h.object.matrixWorld):new THREE.Vector3(0,1,0);
      if(n.y>0.4){layer=b.y+1;cx=Math.floor(h.point.x+GRID/2);cz=Math.floor(h.point.z+GRID/2);}
      else if(n.y<-0.4){layer=Math.max(0,b.y-1);cx=Math.floor(h.point.x+GRID/2);cz=Math.floor(h.point.z+GRID/2);}
      else{layer=b.y;cx=Math.floor(h.point.x+n.x*0.5+GRID/2);cz=Math.floor(h.point.z+n.z*0.5+GRID/2);}}
    const f=effSize();
    return {x:Math.min(Math.max(cx,0),GRID-f[0]),z:Math.min(Math.max(cz,0),GRID-f[1]),layer:layer,brickId:h.object.userData.id};
