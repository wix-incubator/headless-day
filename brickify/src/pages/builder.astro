    const ins=y-4;if(x>=ins-1&&x<=7-(ins-1)&&z>=ins-1&&z<=7-(ins-1))return 'red';return null;}
  function loadVoxel(dims,cell){clearAll(true);const SX=dims[0],SY=dims[1],SZ=dims[2];const ox=Math.floor((GRID-SX)/2),oz=Math.floor((GRID-SZ)/2);
    for(let y=0;y<SY;y++)tile(SX,SZ,(x,z)=>cell(x,y,z)).forEach(r=>{const x=ox+r.a,z=oz+r.b;if(footprintFree(x,z,y,r.w,r.d))addPiece(x,z,y,r.w,r.d,r.c,'brick',false);});
    history.length=0;updateParts();}

  // ---- UI ----
  function chip(txt,on,fn,cls){const b=document.createElement('button');b.className='chip'+(cls?' '+cls:'')+(on?' on':'');b.textContent=txt;b.onclick=fn;return b;}
  function refresh(c,items){c.innerHTML='';items.forEach(el=>c.appendChild(el));}

  refresh(document.getElementById('templates'),[
    chip('Blank',false,()=>clearAll(true)),
    chip('🏡 Villa',false,loadVilla),
    chip('🏛 Sanctum',false,loadSanctum),
    chip('🏠 House',false,()=>loadVoxel([8,8,8],houseCell)),
  ]);

  const catsEl=document.getElementById('cats');
  function renderCats(){refresh(catsEl,CATS.map(c=>chip(c,curCat===c,()=>{curCat=c;renderCats();renderParts();})));}
  const partsEl=document.getElementById('parts-list');
  function renderParts(){const list=CATALOG.filter(d=>d.cat===curCat);
    refresh(partsEl,list.map(d=>chip(d.tag,curDesign.id===d.id,()=>{curDesign=d;curRot=0;makeGhost();renderParts();document.getElementById('partName').textContent=d.name+' · #'+d.id;})));
    document.getElementById('partName').textContent=curDesign.name+' · #'+curDesign.id;}
  const colorsEl=document.getElementById('colors');
  function renderColors(){colorsEl.innerHTML='';COLORS.forEach(c=>{const d=document.createElement('div');d.className='sw'+(curColor===c[0]?' on':'');
    d.style.background='#'+c[2].toString(16).padStart(6,'0');d.title=c[1];d.onclick=()=>{curColor=c[0];renderColors();document.getElementById('colName').textContent=c[1];};colorsEl.appendChild(d);});
    document.getElementById('colName').textContent=CMAP[curColor].name;}
  const toolsEl=document.getElementById('tools');
  function renderTools(){refresh(toolsEl,[
    chip('Build',tool==='build',()=>{tool='build';renderTools();}),
    chip('Delete',tool==='delete',()=>{tool='delete';renderTools();if(ghost)ghost.visible=false;}),
    chip('Undo',false,undo),
    chip('Rotate',false,()=>{curRot=(curRot+1)%4;makeGhost();}),
    chip('Clear',false,()=>{if(confirm('Clear all parts?'))clearAll(true);}),
  ]);}
  function undo(){const op=history.pop();if(!op)return;
    if(op.type==='add')removeBrick(op.id,false);
    else if(op.type==='remove'){const d=op.data;if(footprintFree(d.x,d.z,d.y,d.w,d.d))addPiece(d.x,d.z,d.y,d.w,d.d,d.color,d.fam,false);}}
  addEventListener('keydown',e=>{if((e.ctrlKey||e.metaKey)&&e.key==='z'){e.preventDefault();undo();}});
  document.getElementById('resetView').onclick=()=>{theta=4.0;phi=1.0;radius=64;};
  // bill of materials → [{name, colour, qty}] (colour NAME, matching the Wix variant choice)
  function packBOM(){
    var counts={};
    placed.forEach(function(b){var k=b.name+'|'+b.color;if(!counts[k])counts[k]={name:b.name,colour:(CMAP[b.color]?CMAP[b.color].name:b.color),qty:0};counts[k].qty++;});
    return Object.keys(counts).map(function(k){return counts[k];});
  }
  document.getElementById('buy').onclick=async function(){
    var btn=this, items=packBOM();
    if(!items.length){alert('Add some bricks first!');return;}
    var old=btn.textContent; btn.disabled=true; btn.textContent='Preparing checkout…';
    try{
      var r=await fetch('/api/checkout',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({items:items})});
      var d=await r.json();
      if(d&&d.url){window.location.href=d.url;return;}
      throw new Error((d&&d.error||'no checkout url')+(d&&d.unresolved&&d.unresolved.length?' · unresolved: '+d.unresolved.join(', '):''));
    }catch(e){alert('Checkout not ready yet.\n\nMake sure the catalog is seeded (/api/seed-catalog) and a payment method is connected.\n\n('+(e&&e.message||e)+')');}
    btn.disabled=false; btn.textContent=old;
  };
  document.getElementById('catcount').textContent=SKU.toLocaleString()+' parts';

  makeGhost();renderCats();renderParts();renderColors();renderTools();
  loadVilla();
})();
</script>
</body>
</html>
