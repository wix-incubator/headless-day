    </div>
  </section>

  <!-- Section 4 — Testimonials -->
  <section style="position: relative; z-index: 1; background: rgba(15,14,26,0.68); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); border-top: 1px solid var(--color-rule); border-bottom: 1px solid var(--color-rule); padding: 6rem 1.5rem;">
    <div style="max-width: 1280px; margin: 0 auto;">
      <p style="font-family: var(--font-body); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-accent); text-align: center; margin-bottom: 0.75rem;">Guests</p>
      <h2 style="font-family: var(--font-display); font-size: 2.25rem; color: var(--color-ink); text-align: center; margin-bottom: 3rem;">What people say</h2>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
        {testimonials.length > 0 ? testimonials.map((t: any) => (
          <figure style="background: var(--color-paper-warm); border: 1px solid var(--color-rule); border-radius: var(--radius-md); padding: 2rem; margin: 0; display: flex; flex-direction: column; gap: 1.25rem; transition: box-shadow 0.3s ease;" class="testimonial-card">
            <blockquote style="font-family: var(--font-display); font-size: 1.0625rem; font-style: italic; color: var(--color-ink); line-height: 1.65; margin: 0; flex: 1;">"{t.quote ?? t.body ?? t.text ?? ''}"</blockquote>
            <figcaption>
              <p style="font-family: var(--font-body); font-size: 0.9375rem; font-weight: 600; color: var(--color-ink);">{t.name ?? t.guestName ?? 'A guest'}</p>
              {(t.favoriteGame ?? t.game) && (
                <p style="font-family: var(--font-body); font-size: 0.8125rem; color: var(--color-mute); margin-top: 0.25rem;">Favorite game: {t.favoriteGame ?? t.game}</p>
              )}
            </figcaption>
          </figure>
        )) : (
          /* Fallback testimonials */
          <>
            <figure style="background: var(--color-paper-warm); border: 1px solid var(--color-rule); border-radius: var(--radius-md); padding: 2rem; margin: 0; display: flex; flex-direction: column; gap: 1.25rem; transition: box-shadow 0.3s ease;" class="testimonial-card">
              <blockquote style="font-family: var(--font-display); font-size: 1.0625rem; font-style: italic; color: var(--color-ink); line-height: 1.65; margin: 0; flex: 1;">"We spent three hours there on a Tuesday afternoon. The staff explained Wingspan in five minutes and then left us completely alone. Perfect."</blockquote>
              <figcaption>
                <p style="font-family: var(--font-body); font-size: 0.9375rem; font-weight: 600; color: var(--color-ink);">Sigríður H.</p>
                <p style="font-family: var(--font-body); font-size: 0.8125rem; color: var(--color-mute); margin-top: 0.25rem;">Favorite game: Wingspan</p>
              </figcaption>
            </figure>
            <figure style="background: var(--color-paper-warm); border: 1px solid var(--color-rule); border-radius: var(--radius-md); padding: 2rem; margin: 0; display: flex; flex-direction: column; gap: 1.25rem; transition: box-shadow 0.3s ease;" class="testimonial-card">
              <blockquote style="font-family: var(--font-display); font-size: 1.0625rem; font-style: italic; color: var(--color-ink); line-height: 1.65; margin: 0; flex: 1;">"Brought my parents who have never played a board game in their lives. By the end they were asking when we could come back."</blockquote>
              <figcaption>
                <p style="font-family: var(--font-body); font-size: 0.9375rem; font-weight: 600; color: var(--color-ink);">Björn K.</p>
                <p style="font-family: var(--font-body); font-size: 0.8125rem; color: var(--color-mute); margin-top: 0.25rem;">Favorite game: Ticket to Ride</p>
              </figcaption>
            </figure>
            <figure style="background: var(--color-paper-warm); border: 1px solid var(--color-rule); border-radius: var(--radius-md); padding: 2rem; margin: 0; display: flex; flex-direction: column; gap: 1.25rem; transition: box-shadow 0.3s ease;" class="testimonial-card">
              <blockquote style="font-family: var(--font-display); font-size: 1.0625rem; font-style: italic; color: var(--color-ink); line-height: 1.65; margin: 0; flex: 1;">"The hot chocolate alone is worth the trip. The games are just a reason to sit there longer."</blockquote>
              <figcaption>
                <p style="font-family: var(--font-body); font-size: 0.9375rem; font-weight: 600; color: var(--color-ink);">Anna M.</p>
                <p style="font-family: var(--font-body); font-size: 0.8125rem; color: var(--color-mute); margin-top: 0.25rem;">Favorite game: Azul</p>
              </figcaption>
            </figure>
          </>
        )}
      </div>
    </div>
  </section>

  <!-- Section 5 — Booking CTA band -->
  <section style="position: relative; z-index: 1; background: rgba(20,18,32,0.68); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); padding: 5rem 1.5rem; text-align: center; border-top: 1px solid var(--color-rule);">
    <h2 style="font-family: var(--font-display); font-size: 2.5rem; color: var(--color-ink); margin-bottom: 1rem;">Ready to play?</h2>
    <p style="font-family: var(--font-body); color: var(--color-mute); max-width: 40ch; margin: 0 auto 2rem;">No deposit required. Cancel or change anytime up to two hours before your slot.</p>
    <a href="/book" class="btn-primary" style="background: var(--color-accent); color: var(--color-paper); font-weight: 600; padding: 1rem 2.5rem; border-radius: var(--radius-md);">Book a table</a>
    <p style="font-size: 0.8125rem; color: var(--color-mute); margin-top: 1.5rem; font-family: var(--font-body);">Mon–Thu 14:00–23:00 · Fri–Sat 12:00–01:00 · Sun 12:00–22:00</p>
  </section>

</Layout>

