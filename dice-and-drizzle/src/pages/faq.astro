---
import Layout from '../layouts/Layout.astro';
import { items } from '@wix/data';
import { auth } from '@wix/essentials';

const elevatedQuery = auth.elevate(items.query);
const { items: faqResults } = await elevatedQuery("FAQ").ascending('order').limit(50).find();
const faqItems = faqResults;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((q: any) => ({
    "@type": "Question",
    "name": q.question ?? q.title ?? '',
    "acceptedAnswer": {
      "@type": "Answer",
      "text": q.answer ?? q.body ?? ''
    }
  }))
};
---

<Layout title="FAQ" description="Answers to common questions about Dice & Drizzle — reservations, game rules help, group bookings, and more.">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head"></script>

  <!-- Page header -->
  <section style="background: var(--color-paper-warm); padding: 6rem 1.5rem 5rem;">
    <div style="max-width: var(--container-3xl); margin: 0 auto;">
      <p style="font-family: var(--font-body); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 1.25rem;">Help</p>
      <h1 style="font-family: var(--font-display); font-size: clamp(2.5rem, 6vw, 4rem); font-weight: 700; color: var(--color-ink); line-height: 1.05;">Frequently asked questions</h1>
    </div>
  </section>

  <!-- FAQ accordion -->
  <section style="background: var(--color-paper); padding: 5rem 1.5rem;">
    <div style="max-width: var(--container-prose); margin: 0 auto;">

      {faqItems.length > 0 ? (
        <div class="faq-list">
          {faqItems.map((item: any, i: number) => (
            <details class="faq-item" style={i === 0 ? 'border-top: 1px solid var(--color-rule);' : ''}>
              <summary class="faq-summary">
                <span class="faq-question">{item.question ?? item.title ?? `Question ${i + 1}`}</span>
                <span class="faq-arrow" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </summary>
              <div class="faq-body">
                <p style="font-family: var(--font-body); font-size: 1rem; color: var(--color-ink); line-height: 1.75;">{item.answer ?? item.body ?? ''}</p>
              </div>
            </details>
          ))}
        </div>
      ) : (
        <!-- Fallback FAQ items -->
        <div class="faq-list">
          {[
            { q: 'Do I need to book in advance?', a: 'Bookings are recommended, especially on weekends and Friday evenings. Walk-ins are welcome when space is available. You can check availability and book online in under two minutes.' },
            { q: 'How does the hourly pricing work?', a: 'You pay per hour, per person. The clock starts when you sit down and stops when you let us know you are finished. There is no minimum time.' },
            { q: 'Can you help us pick a game?', a: 'Yes. Our staff love this part. Tell us how many people are at your table, roughly how long you have, and whether you prefer something competitive or cooperative. We will bring you three options and explain each one in a minute or less.' },
            { q: 'Is there food and drink?', a: 'We serve coffee, tea, and hot chocolate made from scratch. There is a small selection of pastries, cheese plates, and snacks. We do not serve full meals, but you are welcome to bring your own food.' },
            { q: 'Do you host private events?', a: 'Yes. We can close a section of the cafe for groups of eight or more. Send us a message through the contact form and we will put together a quote within one business day.' },
            { q: 'What is your cancellation policy?', a: 'You can cancel or change your booking up to two hours before your slot at no charge. No deposit is required at the time of booking.' },
          ].map((item, i) => (
            <details class="faq-item" style={i === 0 ? 'border-top: 1px solid var(--color-rule);' : ''}>
              <summary class="faq-summary">
                <span class="faq-question">{item.q}</span>
                <span class="faq-arrow" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </summary>
              <div class="faq-body">
                <p style="font-family: var(--font-body); font-size: 1rem; color: var(--color-ink); line-height: 1.75;">{item.a}</p>
              </div>
            </details>
          ))}
        </div>
      )}

      <!-- Still have questions -->
      <div style="margin-top: 4rem; padding: 2rem; background: var(--color-paper-warm); border: 1px solid var(--color-rule); border-radius: var(--radius-md); text-align: center;">
        <p style="font-family: var(--font-display); font-size: 1.5rem; color: var(--color-ink); margin-bottom: 0.75rem;">Still have a question?</p>
        <p style="font-family: var(--font-body); font-size: 0.9375rem; color: var(--color-mute); margin-bottom: 1.5rem;">The team checks messages every morning. We usually reply the same day.</p>
        <a href="mailto:hello@diceanddrizzle.is" style="font-family: var(--font-body); font-size: 0.9375rem; font-weight: 600; color: var(--color-ink); border-bottom: 1px solid var(--color-accent); padding-bottom: 2px;">hello@diceanddrizzle.is</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background: var(--color-paper-warm); border-top: 1px solid var(--color-rule); padding: 4rem 1.5rem; text-align: center;">
    <p style="font-family: var(--font-body); font-size: 1rem; color: var(--color-mute); margin-bottom: 1.5rem;">Ready to come in?</p>
    <a href="/book" class="btn-primary" style="background: var(--color-accent); color: var(--color-ink); font-weight: 600; padding: 1rem 2.5rem; border-radius: var(--radius-md);">Book a table</a>
  </section>
</Layout>

<style>
  .faq-list {
    display: flex;
    flex-direction: column;
  }

  .faq-item {
    border-bottom: 1px solid var(--color-rule);
  }

  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem 0;
    cursor: pointer;
    list-style: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-question {
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 600;
    color: var(--color-ink);
    line-height: 1.3;
  }

  .faq-arrow {
    flex-shrink: 0;
    color: var(--color-accent);
    transition: transform 220ms ease;
  }

  .faq-item[open] .faq-arrow {
    transform: rotate(180deg);
  }

  .faq-item[open] .faq-question {
    color: var(--color-ink);
  }

  .faq-summary:hover .faq-question {
    color: var(--color-accent);
  }

  .faq-body {
    padding: 0 0 1.75rem;
    animation: faq-open 200ms ease;
  }

  @keyframes faq-open {
    from { opacity: 0; transform: translateY(-4px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>
