      <ellipse cx="600" cy="110" rx="420" ry="40" fill="none" stroke="#34d399" stroke-width="12" opacity="0.14"/>
      <ellipse cx="580" cy="130" rx="300" ry="28" fill="none" stroke="#a78bfa" stroke-width="8" opacity="0.12"/>

      <!-- Distant mountains -->
      <polygon points="0,340 180,180 360,320 0,340" fill="#1a1030" opacity="0.9"/>
      <polygon points="800,340 1000,160 1200,280 1200,340" fill="#1a1030" opacity="0.9"/>
      <polygon points="200,340 380,220 560,310 200,340" fill="#160e2a" opacity="0.8"/>
      <polygon points="640,340 820,230 980,320 640,340" fill="#160e2a" opacity="0.8"/>

      <!-- Central volcano -->
      <polygon points="600,40 480,340 720,340" fill="#2a1848"/>
