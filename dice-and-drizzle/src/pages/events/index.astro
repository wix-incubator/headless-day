---
import Layout from "../../layouts/Layout.astro";
import { wixEventsV2 } from "@wix/events";
import { auth } from "@wix/essentials";

let eventsList = [];
try {
  const elevatedQuery = auth.elevate(wixEventsV2.queryEvents);
  const result = await elevatedQuery().find();
  eventsList = result.items ?? [];
} catch (err) {
  console.error("[events] query failed:", err?.message ?? err);
}

function formatDate(dateStr) {
  if (!dateStr) return "";
  try {
    return new Date(dateStr).toLocaleDateString("en-GB", {
      weekday: "long",
      day: "numeric",
      month: "long",
      year: "numeric",
    });
  } catch {
    return dateStr;
  }
}
---

<Layout title="Events" description="Upcoming events at Dice & Drizzle — board game tournaments, themed nights, and more.">

  <!-- Hero illustration -->
  <div style="width: 100%; background: #0d0b18; overflow: hidden; line-height: 0;">
    <svg viewBox="0 0 1200 480" xmlns="http://www.w3.org/2000/svg" style="width:100%; display:block;" aria-hidden="true">
      <!-- Sky gradient -->
