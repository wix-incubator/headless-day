      <path d="M604 55 Q610 130 607 200 Q609 260 606 300" stroke="#ff6a00" stroke-width="3" fill="none" opacity="0.5" stroke-linecap="round"/>
      <!-- Volcano glow on ground -->
      <ellipse cx="600" cy="340" rx="200" ry="30" fill="#e8532a" opacity="0.12"/>

      <!-- Ground / lava field -->
      <rect x="0" y="335" width="1200" height="145" fill="#110c20"/>
      <path d="M0 335 Q200 320 400 338 Q600 350 800 332 Q1000 318 1200 340 L1200 480 L0 480 Z" fill="#180f2e"/>

      <!-- Long wooden table -->
      <!-- Table top surface -->
      <rect x="120" y="295" width="960" height="45" rx="6" fill="url(#table-wood)"/>
      <!-- Table edge highlight -->
      <rect x="120" y="295" width="960" height="8" rx="3" fill="#7a5230" opacity="0.6"/>
      <!-- Table legs -->
      <rect x="150" y="340" width="22" height="90" rx="4" fill="#4a2e12"/>
      <rect x="1028" y="340" width="22" height="90" rx="4" fill="#4a2e12"/>
      <rect x="350" y="340" width="18" height="80" rx="3" fill="#3d2710"/>
      <rect x="832" y="340" width="18" height="80" rx="3" fill="#3d2710"/>

      <!-- Game boards / cards on table -->
      <!-- Board 1 (left area) -->
      <rect x="165" y="270" width="160" height="28" rx="4" fill="#2d4a1e" opacity="0.9"/>
      <rect x="170" y="274" width="60" height="20" rx="2" fill="#3d6428" opacity="0.7"/>
      <rect x="238" y="274" width="40" height="20" rx="2" fill="#c4956a" opacity="0.5"/>
      <!-- Cards scattered -->
      <rect x="340" y="268" width="28" height="38" rx="3" fill="#e8dcc8" opacity="0.85" transform="rotate(-8 340 268)"/>
      <rect x="355" y="265" width="28" height="38" rx="3" fill="#e8dcc8" opacity="0.85" transform="rotate(4 355 265)"/>
      <!-- Dice on table -->
      <rect x="440" y="272" width="24" height="24" rx="4" fill="#e8dcc8" opacity="0.9"/>
      <circle cx="448" cy="280" r="2.5" fill="#3b2f1e"/>
      <circle cx="456" cy="288" r="2.5" fill="#8b3a3a"/>
      <rect x="472" y="274" width="22" height="22" rx="3" fill="#e8dcc8" opacity="0.9"/>
      <circle cx="483" cy="285" r="2.5" fill="#3b2f1e"/>
      <!-- Board 2 (center-right) -->
      <rect x="620" y="266" width="200" height="30" rx="4" fill="#1e2d4a" opacity="0.9"/>
      <rect x="625" y="270" width="80" height="22" rx="2" fill="#28406e" opacity="0.7"/>
      <rect x="715" y="270" width="50" height="22" rx="2" fill="#c4956a" opacity="0.4"/>
      <!-- Cards right -->
      <rect x="840" y="266" width="26" height="36" rx="3" fill="#e8dcc8" opacity="0.85" transform="rotate(6 840 266)"/>
      <rect x="858" y="268" width="26" height="36" rx="3" fill="#e8dcc8" opacity="0.85" transform="rotate(-5 858 268)"/>
      <!-- Mugs on table -->
      <rect x="530" y="264" width="26" height="32" rx="5" fill="#c4956a" opacity="0.8"/>
      <path d="M556 272 C572 272 572 290 556 290" stroke="#c4956a" stroke-width="5" fill="none" stroke-linecap="round" opacity="0.9"/>
      <rect x="940" y="264" width="26" height="32" rx="5" fill="#c4956a" opacity="0.8"/>
      <path d="M966 272 C982 272 982 290 966 290" stroke="#c4956a" stroke-width="5" fill="none" stroke-linecap="round" opacity="0.9"/>

      <!-- People sitting around table (silhouettes) -->
      <!-- Person 1 - far left -->
      <ellipse cx="175" cy="288" rx="22" ry="8" fill="#2a1848" opacity="0.9"/>
      <circle cx="175" cy="268" r="14" fill="#2a1848"/>
      <rect x="161" y="278" width="28" height="12" rx="3" fill="#2a1848"/>
      <!-- Person 2 -->
      <ellipse cx="295" cy="286" rx="22" ry="8" fill="#1e1038" opacity="0.9"/>
      <circle cx="295" cy="264" r="15" fill="#1e1038"/>
      <rect x="280" y="275" width="30" height="13" rx="3" fill="#1e1038"/>
      <!-- Person 3 - leaning forward excitedly -->
      <ellipse cx="420" cy="284" rx="20" ry="7" fill="#241440" opacity="0.9"/>
      <circle cx="418" cy="261" r="14" fill="#241440"/>
      <rect x="404" y="272" width="28" height="14" rx="3" fill="#241440"/>
      <!-- arms reaching -->
      <path d="M404 278 Q385 275 370 278" stroke="#241440" stroke-width="10" fill="none" stroke-linecap="round"/>
      <!-- Person 4 (other side of volcano) -->
      <ellipse cx="780" cy="285" rx="21" ry="7" fill="#241440" opacity="0.9"/>
      <circle cx="782" cy="263" r="14" fill="#241440"/>
      <rect x="768" y="273" width="28" height="14" rx="3" fill="#241440"/>
      <!-- Person 5 -->
      <ellipse cx="900" cy="286" rx="22" ry="8" fill="#1e1038" opacity="0.9"/>
      <circle cx="900" cy="265" r="15" fill="#1e1038"/>
      <rect x="885" y="276" width="30" height="12" rx="3" fill="#1e1038"/>
      <!-- Person 6 - far right, raised hand (excited) -->
      <ellipse cx="1020" cy="284" rx="22" ry="8" fill="#2a1848" opacity="0.9"/>
      <circle cx="1020" cy="262" r="15" fill="#2a1848"/>
      <rect x="1005" y="272" width="30" height="14" rx="3" fill="#2a1848"/>
      <path d="M1035 270 Q1048 255 1042 240" stroke="#2a1848" stroke-width="9" fill="none" stroke-linecap="round"/>
      <!-- Person 7 - background, standing -->
      <circle cx="560" cy="255" r="13" fill="#1a1030" opacity="0.8"/>
      <rect x="547" y="265" width="26" height="32" rx="3" fill="#1a1030" opacity="0.8"/>
      <!-- Person 8 - background right -->
      <circle cx="660" cy="258" r="12" fill="#1a1030" opacity="0.7"/>
      <rect x="648" y="267" width="24" height="30" rx="3" fill="#1a1030" opacity="0.7"/>

      <!-- Warm lantern glow on table -->
      <ellipse cx="320" cy="295" rx="80" ry="20" fill="#c4956a" opacity="0.06"/>
      <ellipse cx="760" cy="295" rx="80" ry="20" fill="#c4956a" opacity="0.06"/>

      <!-- Foreground ground shadow -->
      <rect x="0" y="420" width="1200" height="60" fill="#0a0715" opacity="0.6"/>
