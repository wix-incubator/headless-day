  </div>

  <section style="min-height: 60vh; background: var(--color-paper); padding: 64px 24px 64px;">
    <div style="max-width: 900px; margin: 0 auto;">
      <h1 style="font-family: var(--font-display, 'Cormorant Garamond', serif); font-size: clamp(2rem, 5vw, 3.5rem); color: var(--color-ink, #ede8da); margin-bottom: 8px; font-weight: 700; letter-spacing: -0.01em;">
        Events
      </h1>
      <p style="color: var(--color-mute, #9090b8); font-family: var(--font-body, 'Outfit', sans-serif); margin-bottom: 48px; font-size: 1.05rem;">
        Tournaments, themed nights &amp; board game sessions at Dice &amp; Drizzle.
      </p>

      {eventsList.length === 0 && (
        <p style="color: var(--color-ink-soft, #c4b068); font-family: var(--font-body, 'Outfit', sans-serif); font-size: 1rem;">
          No upcoming events right now — check back soon!
        </p>
      )}

      <div style="display: grid; gap: 24px;">
        {eventsList.map((event) => {
          const start = event.dateAndTimeSettings?.startDate;
          const price = event.registration?.tickets?.lowestPrice;
          const slug = event.slug;
          const location = event.location;

          return (
            <article style="background: var(--color-paper-warm, #211d38); border: 1px solid var(--color-rule, #3a3460); border-radius: 12px; padding: 28px 32px; display: grid; grid-template-columns: 1fr auto; gap: 16px; align-items: start;">
              <div>
                <div style="color: var(--color-accent, #38b572); font-family: var(--font-body, 'Outfit', sans-serif); font-size: 0.8rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 8px;">
                  {start ? formatDate(start) : "Date TBD"}
                </div>
                <h2 style="font-family: var(--font-display, 'Cormorant Garamond', serif); font-size: 1.6rem; color: var(--color-ink, #ede8da); margin: 0 0 8px; font-weight: 700;">
                  {event.title}
                </h2>
                {event.shortDescription && (
                  <p style="color: var(--color-mute, #9090b8); font-family: var(--font-body, 'Outfit', sans-serif); font-size: 0.95rem; margin: 0 0 12px; line-height: 1.6; max-width: 560px;">
                    {event.shortDescription}
                  </p>
                )}
                {location?.name && (
                  <p style="color: var(--color-ink-soft, #c4b068); font-family: var(--font-body, 'Outfit', sans-serif); font-size: 0.85rem; margin: 0;">
                    📍 {location.name}
                    {location.address?.addressLine && `, ${location.address.addressLine}`}
                    {location.address?.city && `, ${location.address.city}`}
                  </p>
                )}
              </div>
              <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 12px; min-width: 120px;">
                {price && (
                  <div style="color: var(--color-ink, #ede8da); font-family: var(--font-body, 'Outfit', sans-serif); font-size: 1.1rem; font-weight: 600;">
                    {price.currency} {price.value}
                  </div>
                )}
                {slug && (
                  <a
                    href={`/events/${slug}`}
                    style="display: inline-block; background: var(--color-accent, #38b572); color: var(--color-paper, #141220); font-family: var(--font-body, 'Outfit', sans-serif); font-size: 0.85rem; font-weight: 700; padding: 10px 20px; border-radius: 6px; text-decoration: none; white-space: nowrap;"
                  >
                    Get Tickets
                  </a>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</Layout>
