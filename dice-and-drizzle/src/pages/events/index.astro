      <circle cx="310" cy="12" r="1" fill="#fff" opacity="0.5"/>
      <circle cx="420" cy="28" r="1.5" fill="#fff" opacity="0.8"/>
      <circle cx="500" cy="8" r="1" fill="#fff" opacity="0.6"/>
      <circle cx="640" cy="22" r="1.5" fill="#fff" opacity="0.7"/>
      <circle cx="720" cy="45" r="1" fill="#fff" opacity="0.5"/>
      <circle cx="820" cy="16" r="1.5" fill="#fff" opacity="0.8"/>
      <circle cx="920" cy="35" r="1" fill="#fff" opacity="0.6"/>
      <circle cx="1020" cy="14" r="1.5" fill="#fff" opacity="0.7"/>
      <circle cx="1100" cy="38" r="1" fill="#fff" opacity="0.5"/>
      <circle cx="1160" cy="20" r="1.5" fill="#fff" opacity="0.8"/>
      <circle cx="60" cy="65" r="1" fill="#fff" opacity="0.4"/>
      <circle cx="370" cy="55" r="1" fill="#fff" opacity="0.5"/>
      <circle cx="870" cy="60" r="1" fill="#fff" opacity="0.4"/>

      <!-- Aurora bands -->
