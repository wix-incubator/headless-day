---
import Layout from "../../layouts/Layout.astro";
import { posts } from "@wix/blog";

const { slug } = Astro.params;

let post: any = null;
let notFound = false;
try {
  const result = await posts.getPostBySlug(slug!, {
    fieldsets: ["CONTENT"],
  });
  post = result.post;
} catch (err: any) {
  console.error("[blog/slug] fetch failed:", err);
  notFound = true;
}

if (!post) {
  return Astro.redirect("/blog");
}

function formatDate(dateStr?: string) {
  if (!dateStr) return "";
  return new Date(dateStr).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
}

// Extract readable text from Ricos content nodes
function extractText(content: any): string {
  if (!content) return "";
  if (post.plainContent) return post.plainContent;
  const sections: { heading?: string; text: string }[] = [];
  const nodes = content.nodes ?? [];
  for (const node of nodes) {
    const textParts = (node.nodes ?? [])
      .filter((n: any) => n.type === "TEXT")
      .map((n: any) => n.textData?.text ?? "");
    const text = textParts.join("");
    if (!text.trim()) continue;
    if (node.type === "HEADING") {
      sections.push({ heading: text, text: "" });
    } else {
      sections.push({ text });
    }
  }
  return sections.map((s) => (s.heading ? `\n${s.heading}\n` : s.text)).join("\n");
}

// Build structured sections for rendering from richContent
interface Section {
  type: "heading" | "paragraph";
  text: string;
  level?: number;
}

function buildSections(richContent: any): Section[] {
  if (!richContent) return [];
  const sections: Section[] = [];
  for (const node of richContent.nodes ?? []) {
    const textParts = (node.nodes ?? [])
      .filter((n: any) => n.type === "TEXT")
      .map((n: any) => n.textData?.text ?? "");
    const text = textParts.join("").trim();
    if (!text) continue;
    if (node.type === "HEADING") {
      sections.push({ type: "heading", text, level: node.headingData?.level ?? 2 });
    } else {
      sections.push({ type: "paragraph", text });
    }
  }
  return sections;
}

const sections = buildSections(post.richContent);
---

<Layout
  title={post.title}
  description={post.excerpt ?? ""}
>
  <!-- Back link -->
  <div style="background: var(--color-paper-warm); border-bottom: 1px solid var(--color-rule); padding: 1rem 1.5rem;">
    <div style="max-width: 48rem; margin: 0 auto;">
      <a href="/blog" style="font-family: var(--font-body); font-size: 0.875rem; color: var(--color-accent); text-decoration: none;">
        ← Back to Blog
      </a>
    </div>
  </div>

  <!-- Post header -->
  <header style="background: var(--color-paper-warm); padding: 4rem 1.5rem 3rem; border-bottom: 1px solid var(--color-rule);">
    <div style="max-width: 48rem; margin: 0 auto;">
      <time style="font-family: var(--font-body); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-mute);">
        {formatDate(post.firstPublishedDate)}
      </time>
      <h1 style="font-family: var(--font-display); font-size: clamp(2rem, 5vw, 3.25rem); font-weight: 700; color: var(--color-ink); line-height: 1.2; margin: 1rem 0 0;">
        {post.title}
      </h1>
      {post.excerpt && (
        <p style="font-family: var(--font-body); color: var(--color-mute); font-size: 1.125rem; line-height: 1.65; margin: 1.25rem 0 0;">
          {post.excerpt}
        </p>
      )}
    </div>
  </header>

  <!-- Post body -->
  <article style="background: var(--color-paper); padding: 3.5rem 1.5rem 6rem;">
    <div style="max-width: 48rem; margin: 0 auto; font-family: var(--font-body); color: var(--color-ink); font-size: 1.0625rem; line-height: 1.75;">
      {sections.length > 0 ? (
        sections.map((section) =>
          section.type === "heading" ? (
            <h2 style="font-family: var(--font-display); font-size: 1.625rem; font-weight: 700; color: var(--color-ink-soft); margin: 2.5rem 0 1rem; line-height: 1.3;">
              {section.text}
            </h2>
          ) : (
            <p style="margin: 0 0 1.5rem; color: var(--color-ink);">
              {section.text}
            </p>
          )
        )
      ) : post.plainContent ? (
        <p style="white-space: pre-wrap;">{post.plainContent}</p>
      ) : (
        <p style="color: var(--color-mute);">Content unavailable.</p>
      )}
    </div>
  </article>
</Layout>
