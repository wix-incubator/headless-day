---
import Layout from "../../layouts/Layout.astro";
import { posts } from "@wix/blog";

let blogPosts: any[] = [];
try {
  const result = await posts.queryPosts({
    fieldsets: ["URL", "COUNTERS"],
    paging: { limit: 20 },
  });
  blogPosts = result.posts ?? [];
} catch (err) {
  console.error("[blog] query failed:", err);
}

function formatDate(dateStr?: string) {
  if (!dateStr) return "";
  return new Date(dateStr).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
}
---

<Layout
  title="Blog"
  description="Stories, tips, and staff picks from Dice & Drizzle, Reykjavik's board game cafe."
>
  <!-- Hero -->
  <section style="background: var(--color-paper-warm); padding: 5rem 1.5rem 4rem; border-bottom: 1px solid var(--color-rule);">
    <div style="max-width: 72rem; margin: 0 auto;">
      <p style="font-family: var(--font-body); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 1rem;">From the Cafe</p>
      <h1 style="font-family: var(--font-display); font-size: clamp(2.5rem, 6vw, 4rem); color: var(--color-ink); font-weight: 700; margin-bottom: 1rem;">
        The Dice & Drizzle Blog
      </h1>
      <p style="font-family: var(--font-body); color: var(--color-mute); font-size: 1.0625rem; max-width: 44rem;">
        Rules explanations, staff stories, game recommendations, and dispatches from the tables of Reykjavik's favourite board game cafe.
      </p>
    </div>
  </section>

  <!-- Post grid -->
  <section style="background: var(--color-paper); padding: 4rem 1.5rem 6rem;">
    <div style="max-width: 72rem; margin: 0 auto;">
      {blogPosts.length === 0 ? (
        <p style="font-family: var(--font-body); color: var(--color-mute); text-align: center; padding: 4rem 0;">
          No posts found. Check back soon.
        </p>
      ) : (
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); gap: 2rem;">
          {blogPosts.map((post) => (
            <article style="background: var(--color-paper-warm); border: 1px solid var(--color-rule); border-radius: 0.5rem; overflow: hidden; display: flex; flex-direction: column; transition: border-color 0.2s;">
              <div style="padding: 2rem 2rem 1.5rem; flex: 1;">
                <time style="font-family: var(--font-body); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-mute);">
                  {formatDate(post.firstPublishedDate)}
                </time>
                <h2 style="font-family: var(--font-display); font-size: 1.5rem; font-weight: 700; color: var(--color-ink); margin: 0.75rem 0 0.75rem; line-height: 1.3;">
                  <a
                    href={`/blog/${post.slug}`}
                    style="color: inherit; text-decoration: none;"
                  >
                    {post.title}
                  </a>
                </h2>
                {post.excerpt && (
                  <p style="font-family: var(--font-body); color: var(--color-mute); font-size: 0.9375rem; line-height: 1.6; margin: 0;">
                    {post.excerpt}
                  </p>
                )}
              </div>
              <div style="padding: 1.25rem 2rem; border-top: 1px solid var(--color-rule);">
                <a
                  href={`/blog/${post.slug}`}
                  style="font-family: var(--font-body); font-size: 0.875rem; font-weight: 600; color: var(--color-accent); text-decoration: none; letter-spacing: 0.05em;"
                >
                  Read more →
                </a>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>
