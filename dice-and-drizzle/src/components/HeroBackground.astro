<style>
  .hero-anim {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .iceland-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Dice stage — bottom-right of hero, in front of volcano */
  .dice-stage {
    position: absolute;
    bottom: 10%;
    right: 4%;
    display: flex;
    align-items: flex-end;
    gap: 28px;
    perspective: 900px;
    z-index: 3;
  }

  /* Shared face */
  .df {
    position: absolute;
    background: #f0e8d0;
    border: 2px solid #b8a880;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: inset 0 0 10px rgba(0,0,0,0.10);
  }
  .df svg { width: 68%; height: 68%; }

  /* Die 1 — 90px */
  .die-1 { width:90px; height:90px; position:relative; transform-style:preserve-3d; will-change:transform; }
  .die-1 .df { width:90px; height:90px; border-radius:10px; }
  .die-1 .df-f  { transform: translateZ(45px); }
  .die-1 .df-bk { transform: rotateY(180deg) translateZ(45px); }
  .die-1 .df-r  { transform: rotateY(90deg)  translateZ(45px); }
  .die-1 .df-l  { transform: rotateY(-90deg) translateZ(45px); }
  .die-1 .df-t  { transform: rotateX(90deg)  translateZ(45px); }
  .die-1 .df-bo { transform: rotateX(-90deg) translateZ(45px); }

  /* Die 2 — 70px, slightly elevated */
  .die-2 { width:70px; height:70px; position:relative; transform-style:preserve-3d; will-change:transform; margin-bottom:18px; }
  .die-2 .df { width:70px; height:70px; border-radius:8px; }
  .die-2 .df-f  { transform: translateZ(35px); }
  .die-2 .df-bk { transform: rotateY(180deg) translateZ(35px); }
  .die-2 .df-r  { transform: rotateY(90deg)  translateZ(35px); }
  .die-2 .df-l  { transform: rotateY(-90deg) translateZ(35px); }
  .die-2 .df-t  { transform: rotateX(90deg)  translateZ(35px); }
  .die-2 .df-bo { transform: rotateX(-90deg) translateZ(35px); }

  /* Die 3 — 55px */
  .die-3 { width:55px; height:55px; position:relative; transform-style:preserve-3d; will-change:transform; }
  .die-3 .df { width:55px; height:55px; border-radius:6px; }
  .die-3 .df-f  { transform: translateZ(27.5px); }
  .die-3 .df-bk { transform: rotateY(180deg) translateZ(27.5px); }
  .die-3 .df-r  { transform: rotateY(90deg)  translateZ(27.5px); }
  .die-3 .df-l  { transform: rotateY(-90deg) translateZ(27.5px); }
  .die-3 .df-t  { transform: rotateX(90deg)  translateZ(27.5px); }
  .die-3 .df-bo { transform: rotateX(-90deg) translateZ(27.5px); }
</style>

<script>
  (() => {
    // Init lava stroke-dasharray
    const flows = Array.from(document.querySelectorAll<SVGPathElement>('.lava-flow'));
    const lens = flows.map(p => {
      const len = p.getTotalLength();
      p.style.strokeDasharray = String(len);
      p.style.strokeDashoffset = String(len);
      return len;
    });

    const dice = [
      document.querySelector<HTMLElement>('.die-1')!,
      document.querySelector<HTMLElement>('.die-2')!,
      document.querySelector<HTMLElement>('.die-3')!,
    ];

    const speeds  = [220, 165, 290];
    const phX = [10, 55, 110];
    const phY = [25, 95, 175];
    const phZ = [0,  38, 72];
    const stagger = [0, 0.06, 0.13, 0.20, 0.09];

    let smooth = 0, raw = 0;
    window.addEventListener('scroll', () => { raw = window.scrollY; }, { passive: true });

    function frame() {
      smooth += (raw - smooth) * 0.09;

      const maxScroll = Math.max(1, document.body.scrollHeight - window.innerHeight);
      const progress = smooth / maxScroll;

      // Roll dice
      dice.forEach((die, i) => {
        if (!die) return;
        const s = speeds[i];
        die.style.transform = [
          `rotateX(${(smooth / s * 360 + phX[i]) % 360}deg)`,
          `rotateY(${(smooth / (s * 0.72) * 360 + phY[i]) % 360}deg)`,
          `rotateZ(${(smooth / (s * 1.55) * 360 + phZ[i]) % 360}deg)`,
        ].join(' ');
      });

      // Reveal lava (eased, staggered)
      flows.forEach((path, i) => {
        const t = Math.max(0, Math.min(1, (progress - 0.08 - stagger[i]) / 0.62));
        const e = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
        path.style.strokeDashoffset = String(lens[i] * (1 - e));
      });

      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  })();
</script>
