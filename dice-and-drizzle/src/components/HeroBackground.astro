      <circle cx="720"  cy="14"  r="1.3" fill="white" opacity="0.80"/>
      <circle cx="795"  cy="48"  r="1.1" fill="white" opacity="0.70"/>
      <circle cx="865"  cy="30"  r="1.5" fill="white" opacity="0.60"/>
      <circle cx="940"  cy="75"  r="1.0" fill="white" opacity="0.80"/>
      <circle cx="1010" cy="20"  r="1.2" fill="white" opacity="0.90"/>
      <circle cx="1085" cy="55"  r="0.9" fill="white" opacity="0.65"/>
      <circle cx="1155" cy="33"  r="1.4" fill="white" opacity="0.75"/>
      <circle cx="1230" cy="70"  r="1.1" fill="white" opacity="0.55"/>
      <circle cx="1300" cy="28"  r="1.0" fill="white" opacity="0.85"/>
      <circle cx="1370" cy="58"  r="1.3" fill="white" opacity="0.60"/>
      <circle cx="90"   cy="115" r="0.8" fill="white" opacity="0.45"/>
