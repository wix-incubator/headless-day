      <div class="df df-l" ><svg viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg"><circle cx="15" cy="12" r="5.5" fill="#1a1208"/><circle cx="45" cy="12" r="5.5" fill="#1a1208"/><circle cx="15" cy="30" r="5.5" fill="#1a1208"/><circle cx="45" cy="30" r="5.5" fill="#1a1208"/><circle cx="15" cy="48" r="5.5" fill="#1a1208"/><circle cx="45" cy="48" r="5.5" fill="#1a1208"/></svg></div>
