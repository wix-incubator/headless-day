<div class="hero-anim" aria-hidden="true">

  <svg class="iceland-svg" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="gSky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%"   stop-color="#06060f"/>
        <stop offset="55%"  stop-color="#0d1828"/>
        <stop offset="100%" stop-color="#150806"/>
      </linearGradient>
      <radialGradient id="gA1" cx="22%" cy="40%" r="48%">
        <stop offset="0%"   stop-color="#00ff88" stop-opacity="0.18"/>
        <stop offset="100%" stop-color="#00ff88" stop-opacity="0"/>
      </radialGradient>
      <radialGradient id="gA2" cx="72%" cy="28%" r="44%">
        <stop offset="0%"   stop-color="#8833ee" stop-opacity="0.20"/>
        <stop offset="100%" stop-color="#8833ee" stop-opacity="0"/>
      </radialGradient>
      <radialGradient id="gCrater" cx="50%" cy="50%" r="50%">
        <stop offset="0%"   stop-color="#ff5500" stop-opacity="0.95"/>
        <stop offset="100%" stop-color="#ff2200" stop-opacity="0"/>
      </radialGradient>
      <radialGradient id="gLavaGlow" cx="1054" cy="295" r="180" gradientUnits="userSpaceOnUse">
        <stop offset="0%"   stop-color="#ff4400" stop-opacity="0.22"/>
        <stop offset="100%" stop-color="#ff4400" stop-opacity="0"/>
      </radialGradient>
      <linearGradient id="gLava" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%"   stop-color="#ff7700"/>
        <stop offset="45%"  stop-color="#cc2200"/>
        <stop offset="100%" stop-color="#880e00"/>
      </linearGradient>
      <radialGradient id="gTable" cx="50%" cy="100%" r="55%">
        <stop offset="0%"   stop-color="#7a2e08" stop-opacity="0.35"/>
        <stop offset="100%" stop-color="#7a2e08" stop-opacity="0"/>
      </radialGradient>
      <filter id="fGlow" x="-40%" y="-40%" width="180%" height="180%">
        <feGaussianBlur stdDeviation="6" result="b"/>
        <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
      </filter>
      <filter id="fAurora" x="-5%" y="-5%" width="110%" height="110%">
        <feTurbulence type="fractalNoise" baseFrequency="0.009 0.055" numOctaves="2" result="n">
          <animate attributeName="baseFrequency" values="0.009 0.055;0.012 0.070;0.009 0.055" dur="9s" repeatCount="indefinite"/>
        </feTurbulence>
        <feDisplacementMap in="SourceGraphic" in2="n" scale="22" xChannelSelector="R" yChannelSelector="G"/>
      </filter>
    </defs>

